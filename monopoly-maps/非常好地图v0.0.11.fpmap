 property.owner;\n    const toll = cmd.payload.toll;\n\n    if (!owner || arrived.id === owner.id || !toll || toll <= 0) {\n        ctx.skip();\n        return;\n    }\n\n    // åªå¯¹æ²³è±šæœ¬äººç”Ÿæ•ˆ\n    if (ctx.modifierData?.ownerPlayerId !== arrived.id) {\n        ctx.skip();\n        return;\n    }\n\n    const player = gameProcess.players.get(arrived.id);\n    if (!player) {\n        ctx.skip();\n        return;\n    }\n\n    player.pufferTollCount = (player.pufferTollCount || 0) + 1;\n    player.buffManager.updateBuff('puffer-toll-display-' + player.id, {\n        description: 'æ¯ä»˜3æ¬¡è¿‡è·¯è´¹å“ˆæ°”å…å• Â· è¿›åº¦ ' + (player.pufferTollCount % 3) + '/3'\n    });\n\n    if (player.pufferTollCount % 3 === 0) {\n        cmd.payload.toll = 0;\n        gameProcess.msgNotifyBroadcast('info',\n            arrived.name + ' å“ˆæ°”äº†ï¼ç¬¬' + player.pufferTollCount + 'æ¬¡è¿‡è·¯è´¹å…å•ï¼');\n    }\n});"},{"id":"mod-14idg0","name":"ã€è§’è‰²æŠ€èƒ½ã€‘é€†è¡Œ","slug":"reverse_walker","descriptor":{"autoConsume":false,"commandType":"player.walk","meta":{"description":"åå‘è¡Œèµ°","name":"é€†è¡Œ","source":"è§’è‰²æŠ€èƒ½","tags":["movement"],"triggerTiming":"ç§»åŠ¨å‰"},"priority":0,"remainingTriggers":-1,"timing":"before"},"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<ICommandMap, \"player.walk\">, ctx: ICommandContext<ICommandMap, \"player.walk\">) => {\n    cmd.payload.steps = -cmd.payload.steps;\n});"},{"id":"mod-1c2mq0","name":"ã€ç³»ç»Ÿã€‘è‚¡ä»·å‡çº§è”åŠ¨","slug":"stock_build_link","descriptor":{"autoConsume":false,"meta":{"description":"å‡çº§æ—¶å½±å“å…¬å¸è‚¡ä»·","name":"è‚¡ä»·å‡çº§è”åŠ¨","source":"ç³»ç»Ÿ","tags":["stock"],"triggerTiming":"å‡çº§å"},"priority":0,"commandType":"property.level.up","remainingTriggers":-1,"timing":"after"},"effectCode":"(async (property: IProperty, gameProcess: IGameProcess, cmd: ICommand<PropertyCommandMap, \"property.level.up\">, ctx: ICommandContext<PropertyCommandMap, \"property.level.up\">) => {\n    const company = property.company;\n    if (!company) { ctx.skip(); return; }\n    const stockId = 'stock_' + company;\n    gameProcess.stockMarket.triggerEvent(stockId, 'BUILD', 1);\n});"},{"id":"mod-4n070f","name":"ã€æœºä¼šå¡ã€‘å¤åˆ©æ•ˆåº”","slug":"compound_interest_boost","descriptor":{"autoConsume":false,"meta":{"description":"è·å¾—çš„é’±æ•°å¢åŠ 20%","name":"å¤åˆ©æ•ˆåº”","source":"æœºä¼šå¡","tags":["money","buff","compound_interest_boost"],"triggerTiming":"è·å¾—é‡‘é’±æ—¶"},"priority":0,"commandType":"player.money.gain","remainingTriggers":-1,"timing":"before"},"effectCode":"(async ( player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.money.gain\">, ctx: ICommandContext<PlayerCommandMap, \"player.money.gain\">) => {\n    // èµ„äº§å˜ç°å›æµï¼ˆè‚¡ç¥¨å–å‡ºå›æ¬¾ï¼‰ä¸ç®—æ”¶ç›Šï¼Œä¸äº«å—å¤åˆ©åŠ æˆ\n    if (cmd.payload.tag === 'stock_sell') return;\n    cmd.payload.money = Math.ceil(cmd.payload.money * 1.2);\n});"},{"id":"mod-6t40wl","name":"ã€æœºä¼šå¡ã€‘æ—¶é—´å€’æµ","slug":"time_reversal","descriptor":{"autoConsume":true,"meta":{"description":"å›åˆç»“æŸæ—¶è¿”å›å‡ºå‘ä½ç½®","name":"æ—¶é—´å€’æµ","source":"æœºä¼šå¡","tags":["movement","debuff"],"triggerTiming":"å›åˆç»“æŸ"},"priority":0,"commandType":"player.round.end","remainingTriggers":1,"timing":"after"},"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.round.end\">, ctx: ICommandContext<PlayerCommandMap, \"player.round.end\">) => {\n  const playerState = player as IPlayer & { timeReversalMapItemId?: string };\n  const savedMapItemId = playerState.timeReversalMapItemId;\n  if (!savedMapItemId) return;\n  if (!gameProcess.mapData.mapItems.some((mapItem) => mapItem.id === savedMapItemId)) {\n    delete playerState.timeReversalMapItemId;\n    gameProcess.msgNotifyBroadcast('warning', `${player.name} çš„æ—¶é—´å€’æµç›®æ ‡å·²ä¸å­˜åœ¨ï¼Œæ•ˆæœå–æ¶ˆã€‚`);\n    return;\n  }\n  if (!player.tpToMapItem) {\n    throw new Error(\"æ–°ç‰ˆ MapPath ä¼ é€ API ä¸å¯ç”¨\");\n  }\n  await player.tpToMapItem(savedMapItemId);\n  delete playerState.timeReversalMapItemId;\n  await gameProcess.handleArriveEvent(player);\n  gameProcess.msgNotifyBroadcast('info', `${player.name} æ—¶å…‰å€’æµï¼Œå›åˆ°äº†å‡ºå‘ä½ç½®ï¼`);\n  await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n    title: 'æ—¶é—´å€’æµ',\n    content: `<b>${player.name}</b> æ—¶å…‰å€’æµå›åˆ°äº†å‡ºå‘ä½ç½®ï¼`,\n    duration: 3000\n  });\n});"},{"id":"mod-92tduf","name":"ã€æœºä¼šå¡ã€‘åå‘è¡Œèµ°","slug":"reverse_walk","descriptor":{"autoConsume":true,"meta":{"description":"ä¸‹ä¸€ä¸ªå›åˆå€’ç€èµ°è·¯","name":"åå‘è¡Œèµ°","source":"æœºä¼šå¡","tags":["movement","debuff"],"triggerTiming":"è¡Œèµ°å‰"},"priority":0,"commandType":"player.walk","remainingTriggers":1,"timing":"before"},"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.walk\">, ctx: ICommandContext<PlayerCommandMap, \"player.walk\">) => {\n    cmd.payload.steps = -cmd.payload.steps;\n    await gameProcess.msgNotifyBroadcast('warning', `${player.name} è¢«æ–½åŠ äº†åå‘è¡Œèµ°ï¼ä¸‹ä¸€å›åˆå°†å€’ç€èµ°è·¯`);\n});"},{"id":"mod-98v0co","name":"ã€æœºä¼šå¡ã€‘è”ç›Ÿå…å•","slug":"alliance_toll_free_player","descriptor":{"autoConsume":false,"commandType":"player.money.lose","meta":{"description":"ç»“ç›Ÿç©å®¶ä¹‹é—´è¿‡è·¯è´¹å…é™¤","name":"è”ç›Ÿå…å•","source":"æœºä¼šå¡","tags":["alliance"]},"priority":0,"remainingTriggers":-1,"timing":"before"},"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.money.lose\">, ctx: ICommandContext<PlayerCommandMap, \"player.money.lose\">) => {\n  if (cmd.payload.tag !== MoneyTag.PROPOERTY) {\n    return;\n  }\n\n  const alliance = player.allianceWith;\n  const target = cmd.payload.target;\n  if (!alliance || !target || target.id !== alliance.allyId) {\n    return;\n  }\n\n  if (alliance.remainingTimes <= 0) {\n    delete player.allianceWith;\n    if (ctx.modifierId) {\n      player.modifierManager.removeById(ctx.modifierId);\n    }\n    return;\n  }\n\n  alliance.remainingTimes--;\n  cmd.payload.money = 0;\n\n  gameProcess.msgNotifyBroadcast(\n    'info',\n    `${player.name} è”ç›Ÿå…å•ï¼${target.name} çš„åœ°çš®è¿‡è·¯è´¹å…é™¤ï¼ˆå‰©ä½™ ${alliance.remainingTimes} æ¬¡ï¼‰`\n  );\n\n  if (alliance.remainingTimes <= 0) {\n    delete player.allianceWith;\n    if (ctx.modifierId) {\n      player.modifierManager.removeById(ctx.modifierId);\n    }\n  }\n});"},{"id":"mod-9ivu3z","name":"ã€ç³»ç»Ÿã€‘è‚¡ä»·è´­ä¹°è”åŠ¨","slug":"stock_buy_link","descriptor":{"autoConsume":false,"meta":{"description":"åœ°çš®è¢«è´­ä¹°æ—¶å½±å“å…¬å¸è‚¡ä»·","name":"è‚¡ä»·è´­ä¹°è”åŠ¨","source":"ç³»ç»Ÿ","tags":["stock"],"triggerTiming":"æ˜“ä¸»å"},"priority":0,"commandType":"property.owner.change","remainingTriggers":-1,"timing":"after"},"effectCode":"(async (property: IProperty, gameProcess: IGameProcess, cmd: ICommand<PropertyCommandMap, \"property.owner.change\">, ctx: ICommandContext<PropertyCommandMap, \"property.owner.change\">) => {\n  const result = ctx.result;\n  if (!result || !result.newOwner) { ctx.skip(); return; }\n  const company = property.company;\n  if (!company) { ctx.skip(); return; }\n  const stockId = 'stock_' + company;\n  const sellCost = property.sellCost;\n  const intensity = Math.min(sellCost / 1000, 2);\n  gameProcess.stockMarket.triggerEvent(stockId, 'BUILD', intensity);\n});"},{"id":"mod-9wr1vl","name":"ã€æœºä¼šå¡ã€‘æ³¡æ²«ç»æµç¿»å€","slug":"foam_economy_double","descriptor":{"autoConsume":false,"commandType":"property.arrived","meta":{"description":"æ³¡æ²«ç»æµï¼šä¸šä¸»è¿‡è·¯è´¹ç¿»å€","name":"æ³¡æ²«ç»æµç¿»å€","source":"æœºä¼šå¡","tags":["property","buff"]},"priority":0,"remainingTriggers":-1,"timing":"before"},"effectCode":"(async (property: IProperty, gameProcess: IGameProcess, cmd: ICommand<PropertyCommandMap, \"property.arrived\">, ctx: ICommandContext<PropertyCommandMap, \"property.arrived\">) => {\n  // æ£€æŸ¥æ˜¯å¦æœ‰ä¸šä¸»\n  const owner = cmd.payload.owner;\n  if (!owner) {\n    ctx.skip();\n    return;\n  }\n\n  // æ£€æŸ¥ä¸šä¸»æ˜¯å¦åœ¨æ³¡æ²«ç»æµä¸­\n  if (!owner.foamEconomyRound) {\n    ctx.skip();\n    return;\n  }\n\n  // ç¿»å€è¿‡è·¯è´¹ï¼ˆå¦‚æœå­˜åœ¨ï¼‰\n  if (cmd.payload.toll) {\n    cmd.payload.toll *= 2;\n  }\n});"},{"id":"mod-f4jozz","name":"ã€è§’è‰²æŠ€èƒ½ã€‘åŠæ­¥","slug":"half_walker","descriptor":{"autoConsume":false,"commandType":"player.walk","meta":{"description":"æœ‰ç‚¹æ•°æ›´å¤§çš„éª°å­ï¼Œä½†æ˜¯èµ°è·¯çš„è·¯ç¨‹å‡åŠ","name":"åŠæ­¥","source":"è§’è‰²æŠ€èƒ½","tags":["movement"],"triggerTiming":"è¡Œèµ°å‰"},"priority":0,"remainingTriggers":-1,"timing":"before"},"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.walk\">, ctx: ICommandContext<PlayerCommandMap, \"player.walk\">) => {\n    cmd.payload.steps = Math.ceil(cmd.payload.steps / 2);\n});"},{"id":"mod-gh4oyb","name":"ã€æœºä¼šå¡ã€‘ç»æµå¯’å†¬","slug":"economic_winter_debuff","descriptor":{"autoConsume":false,"commandType":"player.money.gain","meta":{"description":"è·å¾—çš„é’±æ•°å‡å°‘20%","name":"ç»æµå¯’å†¬","source":"æœºä¼šå¡","tags":["money","debuff"],"triggerTiming":"è·å¾—é‡‘é’±æ—¶"},"priority":0,"remainingTriggers":-1,"timing":"before"},"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.money.gain\">, ctx: ICommandContext<PlayerCommandMap, \"player.money.gain\">) => {\n    cmd.payload.money = Math.floor(cmd.payload.money * 0.8);\n});"},{"id":"mod-is33dj","name":"ã€ç³»ç»Ÿã€‘è‚¡ä»·æ”¶ç§Ÿè”åŠ¨","slug":"stock_rent_link","descriptor":{"autoConsume":false,"meta":{"description":"æ”¶ç§Ÿæ—¶å½±å“å…¬å¸è‚¡ä»·","name":"è‚¡ä»·æ”¶ç§Ÿè”åŠ¨","source":"ç³»ç»Ÿ","tags":["stock"],"triggerTiming":"æ”¶ç§Ÿå"},"priority":0,"commandType":"property.arrived","remainingTriggers":-1,"timing":"after"},"effectCode":"(async ( property: IProperty, gameProcess: IGameProcess, cmd: ICommand<PropertyCommandMap, \"property.arrived\">, ctx: ICommandContext<PropertyCommandMap, \"property.arrived\">) => {\n    const result = ctx.result;\n    if (!result || !result.toll || result.toll <= 0) { ctx.skip(); return; }\n    const company = property.company;\n    if (!company) { ctx.skip(); return; }\n    const stockId = 'stock_' + company;\n    const intensity = Math.min(result.toll / 500, 3);\n    gameProcess.stockMarket.triggerEvent(stockId, 'RENT', intensity);\n});"},{"id":"mod-j5d4t4","name":"ã€æœºä¼šå¡ã€‘å¤åˆ©æ•ˆåº”æ¸…ç†","slug":"compound_interest_cleanup","descriptor":{"autoConsume":true,"meta":{"description":"3å›åˆåç§»é™¤å¤åˆ©æ•ˆåº”","name":"å¤åˆ©æ•ˆåº”","source":"æœºä¼šå¡","tags":["money","buff"],"triggerTiming":"å›åˆç»“æŸæ—¶"},"priority":0,"commandType":"player.round.end","remainingTriggers":3,"timing":"after"},"effectCode":"(async ( player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.round.end\">, ctx: ICommandContext<PlayerCommandMap, \"player.round.end\">) => {\n    \n});"},{"id":"mod-k1ohbh","name":"ã€ç³»ç»Ÿã€‘è‚¡ä»·é™çº§è”åŠ¨","slug":"stock_downgrade_link","descriptor":{"autoConsume":false,"commandType":"property.level.down","meta":{"description":"é™çº§æ—¶å½±å“å…¬å¸è‚¡ä»·","name":"è‚¡ä»·é™çº§è”åŠ¨","source":"ç³»ç»Ÿ","tags":["stock"],"triggerTiming":"é™çº§å"},"priority":0,"remainingTriggers":-1,"timing":"after"},"effectCode":"(async (property: IProperty, gameProcess: IGameProcess, cmd: ICommand<PropertyCommandMap, \"property.level.down\">, ctx: ICommandContext<PropertyCommandMap, \"property.level.down\">) => {\n  const company = property.company;\n  if (!company) { ctx.skip(); return; }\n  const stockId = 'stock_' + company;\n  gameProcess.stockMarket.triggerEvent(stockId, 'BUILD', -1);\n});"},{"id":"mod-kstz78","name":"ã€æœºä¼šå¡ã€‘å‘½è¿éª°å’’","slug":"dice_curse","descriptor":{"autoConsume":false,"meta":{"description":"è®°å½•æ¥ä¸‹æ¥3æ¬¡æ·éª°å¹¶ç»“ç®—ä¼¤å®³","name":"å‘½è¿éª°å’’","source":"æœºä¼šå¡","tags":["dice","debuff"],"triggerTiming":"æ·éª°å"},"priority":0,"commandType":"player.dice.roll","remainingTriggers":3,"timing":"after"},"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.dice.roll\">, ctx: ICommandContext<PlayerCommandMap, \"player.dice.roll\">) => {\n    const data = player.diceCurse;\n    if (!data || data.resolved) return;\n    if (!ctx.result) return;\n    const rollTotal = (ctx.result as any).diceResult.reduce((sum: number, dr: any) => sum + dr.result, 0);\n    data.rolls.push(rollTotal);\n    const count = data.rolls.length;\n    gameProcess.msgNotifyBroadcast('info', `${player.name} å‘½è¿éª°å’’è®°å½• ${count}/3ï¼šæœ¬æ¬¡ ${rollTotal} ç‚¹`);\n    if (count >= 3) {\n        data.resolved = true;\n        if (player.isBankrupted) {\n            gameProcess.msgNotifyBroadcast('warning', `${player.name} å·²ç ´äº§ï¼Œå‘½è¿éª°å’’ä½œåºŸï¼`);\n        } else {\n            const total = data.rolls.reduce((a: number, b: number) => a + b, 0);\n            const damage = total * 10;\n            await player.cost(damage, 'CARD');\n            gameProcess.msgNotifyBroadcast('warning', `${player.name} å‘½è¿éª°å’’ç»“ç®—ï¼3æ¬¡æ·éª°å…± ${total} ç‚¹ï¼Œå—åˆ° ${damage} ç‚¹ä¼¤å®³ï¼`);\n        }\n    }\n});"},{"id":"mod-sg2izj","name":"ã€æœºä¼šå¡ã€‘ç»æµå¯’å†¬æ¸…ç†","slug":"economic_winter_cleanup","descriptor":{"autoConsume":true,"commandType":"player.round.end","meta":{"description":"3å›åˆåç§»é™¤ç»æµå¯’å†¬æ•ˆæœ","name":"ç»æµå¯’å†¬","source":"æœºä¼šå¡","tags":["money","debuff"],"triggerTiming":"å›åˆç»“æŸæ—¶"},"priority":0,"remainingTriggers":3,"timing":"after"},"effectCode":"(async ( player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.round.end\">, ctx: ICommandContext<PlayerCommandMap, \"player.round.end\">) => {\n \n});"},{"id":"mod-wawnq6","name":"ã€è§’è‰²æŠ€èƒ½ã€‘å†…å¹•æ¶ˆæ¯","slug":"stock_expert_peek","descriptor":{"autoConsume":false,"commandType":"player.round.start","meta":{"description":"å·çœ‹è‚¡ç¥¨èµ°åŠ¿","name":"å†…å¹•æ¶ˆæ¯","source":"è§’è‰²æŠ€èƒ½","tags":["stock"],"triggerTiming":"å›åˆå¼€å§‹æ—¶"},"priority":0,"remainingTriggers":-1,"timing":"after"},"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<ICommandMap, \"player.round.start\">, ctx: ICommandContext<ICommandMap, \"player.round.start\">) => {\n    const result = await gameProcess.peekStockTrend(player.id, {\n        title: 'å†…å¹•æ¶ˆæ¯ - é€‰æ‹©è¦æŸ¥çœ‹çš„è‚¡ç¥¨',\n        cancelText: 'ä¸æŸ¥çœ‹',\n        column: 3\n    });\n    if (!result) {\n        ctx.skip();\n        return;\n    }\n    gameProcess.messageNotify([player.id], {\n        type: 'info',\n        content: 'ã€å†…å¹•æ¶ˆæ¯ã€‘' + result.stockName + ' æœºå¯†è¯„çº§ï¼š' + result.rating\n    });\n});"},{"id":"mod-wxmbrr","name":"ã€è§’è‰²æŠ€èƒ½ã€‘æ‹†è¿","slug":"demolition","descriptor":{"autoConsume":false,"commandType":"property.arrived","meta":{"description":"ä»˜è¿‡è·¯è´¹æ—¶å¯é€‰æ‹©æ”¯ä»˜åŒå€ä½¿åœ°äº§é™ä¸€çº§","name":"æ‹†è¿","source":"è§’è‰²æŠ€èƒ½","tags":["property"],"triggerTiming":"åˆ°è¾¾åœ°äº§å"},"priority":0,"remainingTriggers":-1,"timing":"after"},"effectCode":"(async (property: IProperty, gameProcess: IGameProcess, cmd: ICommand<PropertyCommandMap, \"property.arrived\">, ctx: ICommandContext<PropertyCommandMap, \"property.arrived\">) => {\n  const arrived = cmd.payload.arrivedPlayer;\n  const owner = property.owner;\n  const toll = cmd.payload.toll;\n\n  // åŸºæœ¬æ£€æŸ¥\n  if (!owner || arrived.id === owner.id || !toll || toll <= 0) {\n    ctx.skip();\n    return;\n  }\n\n  const player = gameProcess.players.get(arrived.id);\n  if (!player) {\n    ctx.skip();\n    return;\n  }\n\n  // ã€ç©å®¶é™åˆ¶ã€‘åªæœ‰ç‰¹å®šçš„ä¿®ç‹—ç©å®¶æ‰èƒ½è§¦å‘ï¼ˆé¿å…å¤šä¸ªä¿®ç‹—ç©å®¶å†²çªï¼‰\n  if (ctx.modifierData?.playerId !== arrived.id) {\n    ctx.skip();\n    return;\n  }\n\n  // ã€ç©å®¶é€‰æ‹©ã€‘è¯¢é—®æ˜¯å¦å‘åŠ¨æŠ€èƒ½\n  const confirmResult = await gameProcess.showConfirmDialog(player.id, {\n    title: \"ä¿®ç‹—æŠ€èƒ½ - æ‹†è¿\",\n    content: `è¦æ”¯ä»˜åŒå€è¿‡è·¯è´¹ï¼ˆï¿¥${toll * 2}ï¼‰ä½¿ ${property.name} é™ä¸€çº§å—ï¼Ÿ`,\n  });\n\n  if (!confirmResult.confirm) {\n    ctx.skip();\n    return;\n  }\n\n  // æ‰§è¡Œæ‹†è¿é€»è¾‘\n  const doubleToll = toll * 2;\n  const costRes = await player.cost(doubleToll, MoneyTag.PLAYER, owner);\n  if (costRes.actualCost >= doubleToll) {\n    await property.levelDown();\n    gameProcess.msgNotifyBroadcast(\"info\",\n      `${player.name} å‘åŠ¨æ‹†è¿ï¼é¢å¤–æ”¯ä»˜ ï¿¥${costRes.actualCost}ï¼Œ${property.name} é™ä¸º Lv.${property.level}`\n    );\n  }\n});"},{"id":"mod-y45l0f","name":"ã€æœºä¼šå¡ã€‘éª°å­ç¨","slug":"dice_tax","descriptor":{"autoConsume":true,"meta":{"description":"ä¸‹æ¬¡æ·éª°æ”¯ä»˜ç‚¹æ•°x200","name":"éª°å­ç¨","source":"æœºä¼šå¡","tags":["dice","debuff"],"triggerTiming":"æ·éª°å"},"priority":0,"commandType":"player.dice.roll","remainingTriggers":1,"timing":"after"},"effectCode":"(async ( player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.dice.roll\">, ctx: ICommandContext<PlayerCommandMap, \"player.dice.roll\">) => {\n    const diceResults = ctx.result && (ctx.result as any).diceResult;\n    if (Array.isArray(diceResults)) {\n        const total = diceResults.reduce((sum: number, d: any) => sum + d.result, 0);\n        const rate = 200;\n        const tax = total * rate;\n        const sourcePlayer = gameProcess.players.get(player.diceTaxSource || '');\n        const costRes = await player.cost(tax, 'CARD', sourcePlayer);\n        if (sourcePlayer) await sourcePlayer.gain(costRes.actualCost, 'CARD', player);\n        gameProcess.msgNotifyBroadcast('warning', `${player.name} è¢«å¾æ”¶éª°å­ç¨ ${costRes.actualCost} å—é’±ï¼ˆ${total}ç‚¹x${rate}ï¼‰ï¼`);\n    }\n});"},{"id":"mod-y9h3d8","name":"ã€æœºä¼šå¡ã€‘æ³¡æ²«ç»æµ","slug":"foam_economy","descriptor":{"autoConsume":true,"commandType":"player.round.end","meta":{"description":"æ³¡æ²«ç»æµï¼šå›åˆè®¡æ•°å’Œé™çº§","name":"æ³¡æ²«ç»æµ","source":"æœºä¼šå¡","tags":["property","buff"]},"priority":0,"remainingTriggers":3,"timing":"after"},"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.round.end\">, ctx: ICommandContext<PlayerCommandMap, \"player.round.end\">) => {\n  // å›åˆè®¡æ•° +1\n  player.foamEconomyRound = (player.foamEconomyRound || 0) + 1;\n\n  // æ£€æŸ¥æ˜¯å¦è¾¾åˆ°3å›åˆ\n  if (player.foamEconomyRound >= 3) {\n    // æ¸…é™¤æ³¡æ²«ç»æµçŠ¶æ€\n    delete player.foamEconomyRound;\n\n    // æ¸…ç†æ‰€æœ‰åœ°çš®ä¸Šçš„ç¿»å€ä¿®é¥°å™¨ï¼ˆéå†å…¨éƒ¨åœ°çš®ï¼Œå› ä¸ºå¯èƒ½å·²å–æ‰éƒ¨åˆ†ï¼‰\n    for (const prop of gameProcess.properties.values()) {\n      prop.modifierManager.removeById($mod__foam_economy_double.id);\n    }\n\n    // æ‰€æœ‰å»ºç­‘é™1çº§\n    for (const prop of gameProcess.properties.values()) {\n      if (prop.owner && prop.owner.id === player.id && prop.level > 0) {\n        await prop.levelDown();\n      }\n    }\n\n    await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n      title: 'æ³¡æ²«ç ´è£‚',\n      content: `<b><color:primary>${player.name}</color></b> çš„æ³¡æ²«ç»æµç ´è£‚ï¼Œæ‰€æœ‰å»ºç­‘é™äº†1çº§ï¼`,\n      duration: 3000\n    });\n  }\n})"},{"id":"mod-zcpvhq","name":"ã€æœºä¼šå¡ã€‘éª°å­å°å°","slug":"dice_seal","descriptor":{"autoConsume":true,"meta":{"description":"åªèƒ½æ·1é¢—éª°å­ï¼Œ3å›åˆåå½’è¿˜","name":"éª°å­å°å°","source":"æœºä¼šå¡","tags":["dice","debuff"],"triggerTiming":"æ·éª°å"},"priority":0,"commandType":"player.round.end","remainingTriggers":3,"timing":"after"},"effectCode":"(async ( player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.round.end\">, ctx: ICommandContext<PlayerCommandMap, \"player.round.end\">) => {\n\n});"},{"id":"mod-zunfox","name":"ã€è§’è‰²æŠ€èƒ½ã€‘å‘½è¿æ“æ§","slug":"fate_controller","descriptor":{"autoConsume":false,"commandType":"player.dice.roll","meta":{"description":"50%æ¦‚ç‡é€‰æ‹©ä¸€é¢—éª°å­é‡æ·","name":"å‘½è¿æ“æ§","source":"è§’è‰²æŠ€èƒ½","tags":["dice"],"triggerTiming":"æ·éª°å­å"},"priority":0,"remainingTriggers":-1,"timing":"after"},"effectCode":"(async ( player: IPlayer, gameProcess: IGameProcess, cmd: ICommand<PlayerCommandMap, \"player.dice.roll\">, ctx: ICommandContext<PlayerCommandMap, \"player.dice.roll\">) => {\n    const diceResult = (ctx.result as any)?.diceResult;\n    if (!diceResult || diceResult.length === 0) {\n        ctx.skip();\n        return;\n    }\n    if (Math.random() >= 0.5) {\n        ctx.skip();\n        return;\n    }\n    gameProcess.setCurrentEventName(`${player.name} æ­£åœ¨ä½¿ç”¨ â€œå‘½è¿æ“æ§â€`)\n    const items = diceResult.map((r: any, i: number) => ({\n        id: String(i),\n        display: {\n            id: \"dice-card-\" + i,\n            type: \"div\" as const,\n            variable: { diceIndex: i + 1, diceValue: r.result },\n            children: [$ui__dice_select_card]\n        }\n    }));\n    const { selected } = await gameProcess.showItemSelectDialog(player.id, {\n        title: \"å‘½è¿æ“æ§ - é€‰æ‹©è¦é‡æ·çš„éª°å­\",\n        itemList: items,\n        cancelText: \"ä¸ä½¿ç”¨\"\n    });\n    if (selected.length === 0) {\n        ctx.skip();\n        return;\n    }\n    const idx = Number(selected[0]);\n    const oldResult = diceResult[idx].result;\n    const newResult = (cmd.payload as any).dices[idx].roll();\n    const modified = diceResult.slice();\n    modified[idx] = newResult;\n\n    gameProcess.setCurrentEventName(`${player.name} æ­£åœ¨é‡æ·éª°å­`);\n    gameProcess.gameBroadcast({\n        type: SocketMsgType.RollDiceResult,\n        source: SocketMsgSource.Server,\n        data: {\n            rollDiceResult: [newResult],\n            rollDicePlayerId: player.id\n        },\n        msg: {\n            type: \"info\",\n            content: `${player.name} å‘åŠ¨å‘½è¿æ“æ§ï¼é‡æ·éª°å­${idx + 1}`\n        }\n    });\n    await new Promise((resolve) => setTimeout(resolve, 3000));\n\n    ctx.setResult({ diceResult: modified });\n    gameProcess.msgNotifyBroadcast('warning',\n        `${player.name} å‘åŠ¨å‘½è¿æ“æ§ï¼éª°å­${idx + 1}: ${oldResult} â†’ ${newResult.result}`);\n});"}],"customUIs":[{"id":"custom-ui-4h7odi","name":"è‚¡å¸‚ä¿¡æ¯å±•ç¤ºUI","layout":{"x":0,"y":1,"width":8,"height":6},"uiSchema":"ui-template-vojbrs"},{"id":"custom-ui-a1il6i","name":"æ—¥æœŸ","layout":{"x":0,"y":0,"width":8,"height":1},"uiSchema":"ui-template-azqfcc"}],"gameSettingForm":[{"id":"form-field-p5wzoc","key":"targetMoney","type":"number-input","label":"èƒœåˆ©åˆ¤å®šé‡‘é’±","defaultValue":150000,"min":0},{"id":"gs-1u11w0","key":"inflationCycle","type":"number-input","label":"é€šè´§è†¨èƒ€å‘¨æœŸï¼ˆå‘¨ï¼‰","defaultValue":"1","min":1,"max":52},{"id":"gs-ocbji9","key":"turnTimeout","type":"number-input","label":"å›åˆå€’è®¡æ—¶(ç§’)","defaultValue":15,"min":5,"max":120,"builtIn":true},{"id":"initMoney","key":"initMoney","type":"number-input","label":"åˆå§‹é‡‘é’±","defaultValue":10000,"min":0,"builtIn":true}],"extraLibs":"/** \n * ç©å®¶å‘½ä»¤å†…å®¹æ‹“å±•\n */\ninterface PlayerCommandMap {\n    \n}\n\n/** \n * IPlayer(ç©å®¶) è‡ªå®šä¹‰å†…å®¹æ‹“å±•\n */\ninterface IPlayer {\n    // è¡ŒåŠ¨åŠ›\n    ap: number;\n    totalAp: number;\n\n    // è“„æ°”æŠ€èƒ½è®¡æ•°\n    pufferTollCount?: number;\n\n    // æ³¡æ²«ç»æµå›åˆè®¡æ•°\n    foamEconomyRound?: number;\n\n    // å‘½è¿éª°å’’æ•°æ®\n    diceCurse?: { rolls: number[], resolved: boolean };\n\n    // éª°å­ç¨æ¥æºç©å®¶ID\n    diceTaxSource?: string;\n\n    // æ—¶é—´å€’æµä¿å­˜çš„ä½ç½®\n    timeReversalPosition?: number;\n\n    // éª°å­å°å°æ•°æ®\n    diceSeal?: { remainingRounds: number, removedDices: IDice[] };\n\n    // è”ç›ŸçŠ¶æ€ï¼ˆç®€åŒ–ç‰ˆï¼Œç›´æ¥ç»‘å®šåœ¨ç©å®¶èº«ä¸Šï¼‰\n    allianceWith?: {\n        allyId: string;          // ç›Ÿå‹çš„