ayer.dices) {\n        dice.diceValues = customFaces;\n    }\n    player.modifierManager.add($mod__half_walker);\n})"},{"id":"role-4pb0n6","name":"è‚¡è‚¡å˜å˜","description":"ä¸€åªæ‹¿æŠ¥çº¸çš„ä¼é¹…ï¼Œåœ¨å›åˆå¼€å§‹æ—¶å¯ä»¥æŸ¥çœ‹ä¸€æ”¯è‚¡ç¥¨çš„å†…å¹•æ¶ˆæ¯ã€‚ç»è¿‡èµ·ç‚¹æ—¶è·å¾—è‚¡å¸‚åˆ†çº¢ï¼šåŸºç¡€2000å…ƒ + æŒä»“å¸‚å€¼Ã—5%","color":"#3498DB","imageId":"image-pmo3zm","initCode":"((player: IPlayer, gameProcess: IGameProcess) => {\n    player.modifierManager.add($mod__stock_expert_peek);\n})"},{"id":"role-6g9vqu","name":"é­”æ³•çŒ«å’ª","description":"ä¼šé­”æ³•çš„çŒ«å’ªï¼æ¯æ¬¡æ·éª°å50%æ¦‚ç‡è§¦å‘ï¼Œé€‰æ‹©ä¸€é¢—éª°å­é‡æ·å¹¶ç›´æ¥ä½¿ç”¨æ–°ç»“æœã€‚ç»è¿‡èµ·ç‚¹æ—¶æ·å‘½è¿éª°å­è·å¾—å¥–é‡‘ï¼š1-2ç‚¹=500å…ƒï¼Œ3-4ç‚¹=1500å…ƒï¼Œ5-6ç‚¹=3000å…ƒ","color":"#9B59B6","imageId":"image-57047r","initCode":"((player: IPlayer, gameProcess: IGameProcess) => {\n    player.modifierManager.add($mod__fate_controller);\n})"},{"id":"role-6nd6bp","name":"ä¿®ç‹—","description":"ä¿®ç‹—æ¯æ¬¡ä»˜è¿‡è·¯è´¹æ—¶ï¼Œå¯é€‰æ‹©æ”¯ä»˜åŒå€è´¹ç”¨ä½¿å¯¹æ–¹åœ°äº§é™ä¸€çº§ã€‚ç»è¿‡èµ·ç‚¹æ—¶è·å¾—å»ºç­‘æ´¥è´´ï¼šåŸºç¡€2000å…ƒ + æ¯æ ‹åœ°äº§200å…ƒ","color":"#865b52","imageId":"image-sxlfh0","initCode":"((player: IPlayer, gameProcess: IGameProcess) => {\n  player.buffManager.addBuff({\n    id: `demolition-skill-` + player.id,\n    name: `æ‹†è¿`,\n    triggerTiming: `ä»˜è¿‡è·¯è´¹æ—¶`,\n    description: `å¯é€‰æ‹©æ”¯ä»˜åŒå€è¿‡è·¯è´¹ä½¿å¯¹æ–¹åœ°äº§é™ä¸€çº§`,\n    source: `è§’è‰²æŠ€èƒ½`\n  });\n  gameProcess.properties.forEach((property, propKey) => {\n    property.modifierManager.add($mod__demolition, { contextData: { playerId: player.id } });\n  });\n});"},{"id":"role-updhap","name":"çè™¾","description":"å¯¹ï¼Œè¿™æ˜¯ä¸€åªè™¾ã€‚ä»–ä¼šå¾€åæ–¹å‘èµ°ï¼ˆç¬¬ä¸€åœˆä¸é¢†å·¥èµ„ï¼‰ã€‚ä¹‹åæ¯åœˆé€’å¢è¡¥å¿ï¼šç¬¬äºŒåœˆ2500å…ƒï¼Œç¬¬ä¸‰åœˆèµ·3000å…ƒ","color":"#E74C3C","imageId":"image-qg9xxg","initCode":"((player: IPlayer, gameProcess: IGameProcess) => {\n    if (!gameProcess.reverseWalkers) {\n        gameProcess.reverseWalkers = {};\n    }\n    gameProcess.reverseWalkers[player.id] = { hasCompletedFirstLap: false };\n    player.modifierManager.add($mod__reverse_walker);\n})"},{"id":"role-yce1tw","name":"æ²³è±š","description":"æ²³è±šï¼Œæ¯è¢«æ”¶äº†3æ¬¡è¿‡è·¯è´¹ä¹‹åä¼šå“ˆæ°”ï¼Œå…é™¤ä¸‹ä¸€æ¬¡è¿‡è·¯è´¹ã€‚ç»è¿‡èµ·ç‚¹è·å¾—2000å…ƒå¥–é‡‘ï¼Œè“„æ°”è¿›åº¦+1ï¼ˆæ¯3æ¬¡è“„æ°”å…å•ä¸€æ¬¡è¿‡è·¯è´¹ï¼‰","color":"#1ABC9C","imageId":"image-98npoc","initCode":"((player: IPlayer, gameProcess: IGameProcess) => {\n    player.pufferTollCount = 0;\n    player.buffManager.addBuff({\n        id: `puffer-toll-display-` + player.id,\n        name: `è“„æ°”`,\n        triggerTiming: `è¢«æ”¶è¿‡è·¯è´¹æ—¶`,\n        description: `æ¯ä»˜3æ¬¡è¿‡è·¯è´¹å“ˆæ°”å…å• Â· è¿›åº¦ 0/3`,\n        source: `è§’è‰²æŠ€èƒ½`\n    });\n    player.buffManager.addBuff({\n        id: `puffer-no-start-bonus-` + player.id,\n        name: `æ²³è±šæœ¬æ€§`,\n        triggerTiming: `è¢«åŠ¨æ•ˆæœ`,\n        description: `ç»è¿‡èµ·ç‚¹ä¸è·å¾—å¥–é‡‘`,\n        source: `è§’è‰²æŠ€èƒ½`\n    });\n    gameProcess.properties.forEach((property, propKey) => {\n        property.modifierManager.add($mod__puffer_toll, { contextData: { ownerPlayerId: player.id } });\n    });\n})"}],"inUse":false,"mapEvents":[{"id":"event-6n1nty","name":"è¯åˆ¸ä¸­å¿ƒ","description":"","type":"PassedEvent","iconId":"image-ecemlp","properties":[],"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess) => {\n  gameProcess.setCurrentEventName(`${player.name} æ“ä½œè‚¡ç¥¨`);\n\n  enum StockMode {\n    Buy = \"BUY\",\n    Sell = \"SELL\",\n  }\n\n  const stockMarket = gameProcess.stockMarket;\n  const isAIPlayer = Boolean((player as IPlayer & { isAI?: boolean }).isAI);\n\n  while (true) {\n    const playerMoney = Number(player.money) || 0;\n    const playerHoldings = stockMarket.getPlayerHoldingStock(player.id).filter((record) => record.holding > 0);\n    const buyableStocks = stockMarket.data.stocks.filter((stock) => {\n      const maxBuyAmount = Math.floor(playerMoney / (stock.price * (1 + stockMarket.getTaxRate(true))));\n      return maxBuyAmount > 0;\n    });\n\n    const stockModeItems = [\n      ...((!isAIPlayer || buyableStocks.length > 0) ? [{ id: StockMode.Buy, display: \"è´­ä¹°è‚¡ç¥¨\" }] : []),\n      ...((!isAIPlayer || playerHoldings.length > 0) ? [{ id: StockMode.Sell, display: \"å–å‡ºè‚¡ç¥¨\" }] : []),\n    ];\n\n    if (stockModeItems.length === 0) {\n      break;\n    }\n\n    const stockModeRes = await gameProcess.showItemSelectDialog(player.id, {\n      title: \"è‚¡ç¥¨äº¤æ˜“ç»ˆç«¯\",\n      content: \"æ¬¢è¿æ¥åˆ°äº¤æ˜“ä¸­å¿ƒï¼Œé€‰æ‹©åŠç†çš„ä¸šåŠ¡\",\n      closable: true,\n      cancelText: \"é€€å‡º\",\n      column: 2,\n      itemList: stockModeItems,\n    });\n\n    if (stockModeRes.selected.length === 0) {\n      break;\n    }\n    const stockMode = stockModeRes.selected[0] as StockMode;\n\n    const isBuy = stockMode === StockMode.Buy;\n    const config = {\n      title: isBuy ? \"ä¹°å…¥è‚¡ç¥¨\" : \"å–å‡ºè‚¡ç¥¨\",\n      actionName: isBuy ? \"ä¹°å…¥\" : \"å–å‡º\",\n      cancelText: \"è¿”å›\",\n    };\n\n    if (!isBuy && playerHoldings.length === 0) {\n      gameProcess.messageNotify([player.id], { type: \"error\", content: \"ä½ æ²¡æœ‰è‚¡ç¥¨å¯ä»¥å‡ºå”®\" });\n      if (isAIPlayer) {\n        break;\n      }\n      continue;\n    }\n\n    const candidateStocks = isBuy ? (isAIPlayer ? buyableStocks : stockMarket.data.stocks) : playerHoldings.map((record) => record.stock);\n    if (candidateStocks.length === 0) {\n      if (isBuy) {\n        gameProcess.messageNotify([player.id], { type: \"warning\", content: \"å½“å‰æ²¡æœ‰å¯ä¹°å…¥çš„è‚¡ç¥¨\" });\n      }\n      if (isAIPlayer) {\n        break;\n      }\n      continue;\n    }\n\n    const chooseStockRes = await gameProcess.showItemSelectDialog(player.id, {\n      title: config.title,\n      content: `è¯·é€‰æ‹©è¦${config.actionName}çš„è‚¡ç¥¨`,\n      cancelText: config.cancelText,\n      itemList: candidateStocks.map(turnStockToSelectorItem),\n    }, { timeout: 30000 });\n\n    if (chooseStockRes.selected.length === 0) {\n      if (isAIPlayer) {\n        break;\n      }\n      continue;\n    }\n\n    const choosedStock = stockMarket.getStock(chooseStockRes.selected[0]);\n    if (!choosedStock) {\n      if (isAIPlayer) {\n        break;\n      }\n      continue;\n    }\n\n    const numLimit = isBuy\n      ? Math.floor(playerMoney / (choosedStock.price * (1 + stockMarket.getTaxRate(true))))\n      : stockMarket.getHolding(player.id, choosedStock.id);\n\n    if (numLimit <= 0) {\n      gameProcess.messageNotify([player.id], {\n        type: \"warning\",\n        content: isBuy ? \"ä½ çš„èµ„é‡‘ä¸è¶³ä»¥ä¹°å…¥è¿™åªè‚¡ç¥¨\" : \"ä½ æ²¡æœ‰è¶³å¤Ÿçš„æŒä»“å¯ä»¥å–å‡º\",\n      });\n      if (isAIPlayer) {\n        break;\n      }\n      continue;\n    }\n\n    const stockNumRes = await gameProcess.showFormDialog(player.id, {\n      title: `${config.actionName} ${choosedStock.name}`,\n      content: {\n        id: \"stock-trade-info\",\n        type: \"div\",\n        variable: {\n          actionName: config.actionName,\n          stockPrice: choosedStock.price,\n          taxRate: stockMarket.getTaxRate(isBuy) * 100,\n          numLimit,\n        },\n        children: [$ui__stock_trade_info],\n      },\n      cancelText: \"æ”¾å¼ƒ\",\n      fields: [{\n        key: \"stockNum\",\n        label: \"äº¤æ˜“è‚¡æ•°\",\n        defaultValue: 0,\n        min: 0,\n        max: numLimit,\n      }],\n    }, { timeout: 30000 });\n\n    if (!stockNumRes.submitted) {\n      if (isAIPlayer) {\n        break;\n      }\n      continue;\n    }\n\n    const stockNum = Number(stockNumRes[\"stockNum\"] ?? 0);\n    if (!Number.isFinite(stockNum) || stockNum <= 0) {\n      if (isAIPlayer) {\n        break;\n      }\n      continue;\n    }\n\n    const canTradeRes = stockMarket.canTrade(player.id, choosedStock.id, stockNum, isBuy);\n    if (!canTradeRes.ok) {\n      gameProcess.messageNotify([player.id], { type: \"error\", content: canTradeRes.msg || \"äº¤æ˜“å¤±è´¥\" });\n      if (isAIPlayer) {\n        break;\n      }\n      continue;\n    }\n\n    if (isBuy) {\n      const receipt = stockMarket.commitBuy(player.id, choosedStock.id, stockNum);\n      if (!receipt) {\n        if (isAIPlayer) {\n          break;\n        }\n        continue;\n      }\n      await player.cost(receipt.totalCost);\n      gameProcess.messageNotify([player.id], { type: \"success\", content: `æˆåŠŸä¹°å…¥ ${choosedStock.name} x${stockNum}è‚¡ï¼Œæ”¯å‡º ${receipt.totalCost} ï¿¥` });\n      gameProcess.messageNotify([...gameProcess.players.keys()].filter((pId) => pId !== player.id), { type: \"success\", content: `${player.name} æˆåŠŸä¹°å…¥ ${choosedStock.name} x${stockNum}è‚¡ï¼Œæ”¯å‡º ${receipt.totalCost} ï¿¥` });\n    } else {\n      const receipt = stockMarket.commitSell(player.id, choosedStock.id, stockNum);\n      if (!receipt) {\n        if (isAIPlayer) {\n          break;\n        }\n        continue;\n      }\n      await player.gain(receipt.totalCost, 'stock_sell');\n      gameProcess.messageNotify([player.id], { type: \"success\", content: `æˆåŠŸå–å‡º ${choosedStock.name} x${stockNum}è‚¡ï¼Œè·å¾— ${receipt.totalCost} ï¿¥` });\n      gameProcess.messageNotify([...gameProcess.players.keys()].filter((pId) => pId !== player.id), { type: \"success\", content: `${player.name} æˆåŠŸå–å‡º ${choosedStock.name} x${stockNum}è‚¡ï¼Œè·å¾— ${receipt.totalCost} ï¿¥` });\n    }\n    gameProcess.gameDataBroadcast();\n\n    if (isAIPlayer) {\n      break;\n    }\n  }\n\n  function turnStockToSelectorItem(stock: Stock): SelectorItem {\n    return {\n      id: stock.id,\n      display: {\n        id: \"stock-display\",\n        type: \"div\",\n        variable: {\n          stockName: stock.name,\n          stockColor: stock.color,\n          areaColor: stock.display.color,\n          areaPath: stock.display.areaPath,\n          linePath: stock.display.linePath,\n          price: stock.display.price,\n          percent: stock.display.percent,\n        },\n        children: [$ui__stock_preview],\n      },\n    };\n  }\n});"},{"id":"event-ctx7rf","name":"èµ·ç‚¹","description":"ç©å®¶ç»è¿‡èµ·ç‚¹æ—¶æ ¹æ®è§’è‰²æœºåˆ¶è·å¾—å¥–é‡‘ï¼Œé‡‘é¢éšé€šèƒ€å€ç‡è°ƒæ•´","type":"PassedEvent","iconId":"image-fc9a81","properties":[],"tempFilePath":"C:\\DEV\\code\\epiboly\\sjz-monopoly\\resource\\èµ·ç‚¹.png","effectCode":"(async (player: IPlayer, gameProcess: IGameProcess) => {\n  const roleId = player.getUser().roleId;\n\n  // ===== é€†è¡Œè€…ï¼ˆçè™¾ï¼‰ï¼šç¬¬ä¸€åœˆä¸é¢†å·¥èµ„ =====\n  const rw = gameProcess.reverseWalkers?.[player.id];\n  if (rw && !rw.hasCompletedFirstLap) {\n    rw.hasCompletedFirstLap = true;\n    gameProcess.msgNotifyBroadcast('warning', `${player.name} æ˜¯é€†è¡Œè€…ï¼Œç¬¬ä¸€åœˆä¸é¢†å·¥èµ„ï¼`);\n    return;\n  }\n\n  // ===== æ ¹æ®è§’è‰²è®¡ç®—å¥–é‡‘ =====\n  let bonus = 2000;  // é»˜è®¤åŸºç¡€å¥–é‡‘\n  let message = `${player.name} ç»è¿‡èµ·ç‚¹ï¼Œè·å¾— ${bonus} å…ƒ`;\n\n  // ä½¿ç”¨ switch-case ä¼˜åŒ–ä»£ç ç»“æ„\n  switch (roleId) {\n    // 1. é­”æ³•çŒ«å’ªï¼šå‘½è¿éª°å­ï¼ˆç‹¬ç«‹æŠ•æ·ï¼‰\n    case 'role-6g9vqu': {\n      const fateResults = await player.rollDices();\n      const fateRoll = fateResults.reduce((sum, d) => sum + d.result, 0);\n      if (fateRoll <= 4) {\n        bonus = 500;\n      } else if (fateRoll <= 10) {\n        bonus = 1500;\n      } else {\n        bonus = 3000;\n      }\n      message = `${player.name} çš„é­”æ³•çŒ«å’ªæ·å‡º ${fateRoll} ç‚¹ï¼Œè·å¾— ${bonus} å…ƒï¼`;\n      break;\n    }\n\n    // 2. çè™¾ï¼šç¬¬äºŒåœˆèµ·2500ï¼Œç¬¬ä¸‰åœˆèµ·3000\n    case 'role-updhap': {\n      if (rw?.hasCompletedFirstLap && !rw?.lap2 && !rw?.lap3) {\n        bonus = 2500;\n        message = `${player.name} ï¼ˆé€†è¡Œè€…ï¼‰è·å¾—è¡¥å¿ ${bonus} å…ƒï¼`;\n        if (rw) rw.lap2 = true;\n      } else if (rw?.lap2) {\n        bonus = 3000;\n        message = `${player.name} ï¼ˆé€†è¡Œè€…ï¼‰è·å¾—é«˜é¢è¡¥å¿ ${bonus} å…ƒï¼`;\n        if (rw) {\n          rw.lap2 = false;\n          rw.lap3 = true;\n        }\n      } else if (rw?.lap3) {\n        bonus = 3000;\n        message = `${player.name} ï¼ˆé€†è¡Œè€…ï¼‰è·å¾—é«˜é¢è¡¥å¿ ${bonus} å…ƒï¼`;\n      }\n      break;\n    }\n\n    // 3. ä¿®ç‹—ï¼šå»ºç­‘æ´¥è´´\n    case 'role-6nd6bp': {\n      const propertyCount = player.properties.length;\n      const subsidy = propertyCount * 200;\n      bonus = 2000 + subsidy;\n      message = `${player.name} æ‹¥æœ‰ ${propertyCount} æ ‹åœ°äº§ï¼Œè·å¾—æ´¥è´´ ${subsidy} å…ƒï¼Œå…± ${bonus} å…ƒï¼`;\n      break;\n    }\n\n    // 4. æ²³è±šï¼šåŸºç¡€å¥–é‡‘ + è“„æ°”\n    case 'role-yce1tw': {\n      bonus = 2000;\n      player.pufferTollCount = (player.pufferTollCount || 0) + 1;\n      const progress = player.pufferTollCount;\n      const buffId = `puffer-toll-display-${player.id}`;\n      const buff = player.buffManager.getBuffs().find(b => b.id === buffId);\n      if (buff) {\n        player.buffManager.updateBuff(buffId, {\n          description: `æ¯ä»˜3æ¬¡è¿‡è·¯è´¹å“ˆæ°”å…å• Â· è¿›åº¦ ${Math.min(progress, 3)}/3`\n        });\n      }\n      if (progress >= 3) {\n        player.pufferTollCount = 0;\n        player.buffManager.addBuff({\n          id: `puffer-free-${player.id}-${Date.now()}`,\n          name: `æ²³è±šå“ˆæ°”`,\n          triggerTiming: `è¢«åŠ¨æ•ˆæœ`,\n          description: `ä¸‹ä¸€æ¬¡è¿‡è·¯è´¹å…é™¤`,\n          source: `è§’è‰²æŠ€èƒ½`,\n          triggerTimes: 1\n        });\n        message = `${player.name} ç»è¿‡èµ·ç‚¹è·å¾— ${bonus} å…ƒï¼Œè“„æ°”å·²æ»¡ï¼ä¸‹ä¸€æ¬¡è¿‡è·¯è´¹å°†å…å•ï¼`;\n      } else {\n        message = `${player.name} ç»è¿‡èµ·ç‚¹è·å¾— ${bonus} å…ƒï¼Œè“„æ°”è¿›åº¦ ${progress}/3`;\n      }\n      break;\n    }\n\n    // 5. è‚¡è‚¡å˜å˜ï¼šè‚¡å¸‚åˆ†çº¢\n    case 'role-4pb0n6': {\n      const stockMarket = gameProcess.stockMarket;\n      let totalValue = 0;\n      if (stockMarket) {\n        const holdings = stockMarket.getPlayerHoldingStock(player.id);\n        totalValue = holdings.reduce((sum, h) => sum + h.holding * h.stock.price, 0);\n      }\n      const dividend = Math.floor(totalValue * 0.05);\n      bonus = 2000 + dividend;\n      message = `${player.name} æŒä»“å¸‚å€¼ ${totalValue} å…ƒï¼Œåˆ†çº¢ ${dividend} å…ƒï¼Œå…± ${bonus} å…ƒï¼`;\n      break;\n    }\n\n    // 6. çŒªçŒªï¼šéª°å­ç‚¹æ•°åŠ æˆï¼ˆç›´æ¥æŠ•æ·ï¼‰\n    case 'role-2u1dfq': {\n      const diceResults = await player.rollDices();\n      const diceSum = diceResults.reduce((sum, d) => sum + d.result, 0);\n      bonus = diceSum * 300;\n      message = `${player.name} çš„éª°å­ç‚¹æ•°ä¸º ${diceSum}ï¼Œè·å¾—å¥–é‡‘ ${bonus} å…ƒï¼`;\n      break;\n    }\n  }\n\n  // åº”ç”¨é€šèƒ€å€ç‡\n  const inflationRate = gameProcess.inflationRate ?? 1.0;\n  const finalBonus = Math.round(bonus * inflationRate);\n  if (inflationRate !== 1.0) {\n    message = message.replace(`${bonus} å…ƒ`, `${finalBonus} å…ƒï¼ˆé€šèƒ€Ã—${inflationRate.toFixed(2)}ï¼‰`);\n  }\n\n  // å‘æ”¾å¥–é‡‘\n  await player.gain(finalBonus);\n  gameProcess.msgNotifyBroadcast('success', message);\n});"},{"id":"event-dudtrj","name":"æœºä¼šå¡å•†åº—","description":"ç»è¿‡å•†åº—å¯ä»¥è´­ä¹°æœºä¼šå¡","type":"PassedEvent","iconId":"image-fdeqn8","properties":[],"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess) => {\r\n    gameProcess.setCurrentEventName(`${player.name} æ­£åœ¨é€‰è´­æœºä¼šå¡`);\r\n    const chanceCardNum = 3;\r\n    const chancePriceRange = [200, 2000]\r\n    const chanceCardItems = [...gameProcess.chanceCardInfos.values()]\r\n        .sort(() => 0.5 - Math.random())\r\n        .slice(0, chanceCardNum)\r\n        .map(c => {\r\n            const money = randomMoney(chancePriceRange[0], chancePriceRange[1]);\r\n            return {\r\n                id: c.id,\r\n                display: createChanceCardUISchema(c, `${money}ï¿¥`),\r\n                info: c,\r\n                money,\r\n            }\r\n        });\r\n    const res = await gameProcess.showItemSelectDialog(player.id, {\r\n        title: \"æœºä¼šå¡å•†åº—\",\r\n        content: `è´­ä¹°æœºä¼šå¡`,\r\n        itemList: chanceCardItems,\r\n        cancelText: \"ä¸ä¹°\"\r\n    })\r\n\r\n    if (res.selected.length > 0) {\r\n        for (const selectedId of res.selected) {\r\n            const selectedItem = chanceCardItems.find(c => c.id === selectedId);\r\n            if (player.money < selectedItem.money) {\r\n                gameProcess.messageNotify([player.id], { type: \"error\", content: `ä½ çš„é’±ä¸å¤Ÿä¹° ${selectedItem.info.name}` });\r\n                continue;\r\n            }\r\n            await player.cost(selectedItem.money, MoneyTag.SYSTEM);\r\n            await player.gainCard(gameProcess.createNewChanceCard(selectedId));\r\n            gameProcess.msgNotifyBroadcast(\"success\", `${player.name} è´­ä¹°äº†æœºä¼šå¡ ${selectedItem.info.name}`)\r\n        }\r\n    }\r\n\r\n    function createChanceCardUISchema(chanceCard: ChanceCardInfo, money: string): UISchema {\r\n        const { name, description, color } = chanceCard;\r\n        return {\r\n            id: \"chance-card\",\r\n            type: \"div\",\r\n            variable: { name, description, color, money },\r\n            children: [\r\n                $ui__chance_card_info,\r\n                {\r\n                    id: \"money-container\",\r\n                    type: \"div\",\r\n                    style: {\r\n                        width: \"max-content\",\r\n                        margin: 'auto',\r\n                        marginTop: \".6em\",\r\n                        padding: \".2em 1em\",\r\n                        backgroundColor: \"#ffffff\",\r\n                        color: \"var(--fp-color-primary)\",\r\n                        border: \".2em solid\",\r\n                        borderRadius: \".6em\",\r\n                    },\r\n                    children: [{\r\n                        id: 'money-text',\r\n                        type: \"text\",\r\n                        textBinding: 'money',\r\n                    }]\r\n                }\r\n            ],\r\n        };\r\n    }\r\n\r\n    function randomMoney(min: number, max: number): number {\r\n        const raw = Math.random() * (max - min) + min;\r\n        return Math.floor(raw / 100) * 100;\r\n    }\r\n});"},{"id":"event-f8rdwz","name":"é­”æ³•å±‹","description":"é€‰æ‹©ä¸€ä¸ªäº‹ä»¶ï¼Œå¯¹æ»¡è¶³éšæœºæ¡ä»¶çš„äººç”Ÿæ•ˆ","type":"ArrivedEvent","iconId":"image-l2exzl","properties":[],"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess) => {\n    interface TargetFilter {\n        name: string,\n        filter: (players: IPlayer[]) => IPlayer[];\n    }\n    interface RandomEvent {\n        id: string,\n        name: string,\n        desc: string,\n        fn: (targets: IPlayer[]) => Promise<void>\n    }\n\n    const targetFilter: TargetFilter[] = [\n        {\n            name: `ç°é‡‘å¤§äº5000å—é’±çš„ç©å®¶`, filter: (players) => {\n                return players.filter((p => p.money > 5000));\n            }\n        },\n        {\n            name: `ç°é‡‘å°äº5000å—é’±çš„ç©å®¶`, filter: (players) => {\n                return players.filter((p => p.money < 5000));\n            }\n        },\n        {\n            name: `æœºä¼šå¡æ•°é‡æœ€å¤šçš„ç©å®¶`, filter: (players) => {\n                const playerCardCounts = players.map(p => ({\n                    player: p,\n                    count: p.chanceCards.length\n                }));\n                const maxCount = Math.max(...playerCardCounts.map(item => item.count));\n                if (maxCount === 0) {\n                    return [];\n                }\n                return playerCardCounts\n                    .filter(item => item.count === maxCount)\n                    .map(item => item.player);\n            }\n        },\n        {\n            name: `æœºä¼šå¡æ•°é‡æœ€å°‘çš„ç©å®¶`, filter: (players) => {\n                const playerCardCounts = players.map(p => ({\n                    player: p,\n                    count: p.chanceCards.length\n                }));\n                const minCount = Math.min(...playerCardCounts.map(item => item.count));\n                if (minCount === 0) {\n                    return [];\n                }\n                return playerCardCounts\n                    .filter(item => item.count === minCount)\n                    .map(item => item.player);\n            }\n        },\n        {\n            name: `æˆ¿äº§æ•°é‡æœ€å¤šçš„ç©å®¶`, filter: (players) => {\n                const playerPropertiesCounts = players.map(p => ({\n                    player: p,\n                    count: p.properties.length\n                }));\n                const maxCount = Math.max(...playerPropertiesCounts.map(item => item.count));\n                if (maxCount === 0) {\n                    return [];\n                }\n                return playerPropertiesCounts\n                    .filter(item => item.count === maxCount)\n                    .map(item => item.player);\n            }\n        },\n        {\n            name: `æˆ¿äº§æ•°é‡æœ€å°‘çš„ç©å®¶`, filter: (players) => {\n                const playerPropertiesCounts = players.map(p => ({\n                    player: p,\n                    count: p.properties.length\n                }));\n                const minCount = Math.min(...playerPropertiesCounts.map(item => item.count));\n                if (minCount === 0) {\n                    return [];\n                }\n                return playerPropertiesCounts\n                    .filter(item => item.count === minCount)\n                    .map(item => item.player);\n            }\n        },\n        {\n            name: `éšæœºä¸€ä½ç©å®¶`, filter: (players) => {\n                return [players[Math.floor(Math.random() * players.length)]];\n            }\n        },\n        {\n            name: `è‚¡ç¥¨æ€»å¸‚å€¼æœ€é«˜çš„ç©å®¶`, filter: (players) => {\n                const stockMarket = gameProcess.stockMarket;\n                const playerValues = players.map(p => {\n                    const holdings = stockMarket.getPlayerHoldingStock(p.id);\n                    const totalValue = holdings.reduce((sum, r) => sum + r.holding * r.stock.price, 0);\n                    return { player: p, value: totalValue };\n                });\n                const maxValue = Math.max(...playerValues.map(item => item.value));\n                if (maxValue === 0) return [];\n                return playerValues.filter(item => item.value === maxValue).map(item => item.player);\n            }\n        },\n        {\n            name: `æ²¡æœ‰æŒæœ‰ä»»ä½•è‚¡ç¥¨çš„ç©å®¶`, filter: (players) => {\n                const stockMarket = gameProcess.stockMarket;\n                return players.filter(p => {\n                    const holdings = stockMarket.getPlayerHoldingStock(p.id);\n                    return holdings.every(r => r.holding <= 0);\n                });\n            }\n        }\n    ];\n\n    const events: RandomEvent[] = [\n        {\n            id: \"gain-money\", name: \"è·å¾—2000å—é’±\", desc: \"ç©å®¶è·å¾—2000å—é’±\",\n            fn: async (players) => {\n                for (const player of players) {\n                    await player.gain(2000);\n                }\n            }\n        },\n        {\n            id: \"cost-money\", name: \"å¤±å»2000å—é’±\", desc: \"ç©å®¶å¤±å»2000å—é’±\",\n            fn: async (players) => {\n                for (const player of players) {\n                    await player.cost(2000);\n                }\n            }\n        },\n        {\n            id: \"build-up\", name: \"éšæœºæå‡ä¸€æ ‹å»ºç­‘çš„ç­‰çº§\", desc: \"ç©å®¶éšæœºæå‡ä¸€æ ‹å»ºç­‘çš„ç­‰çº§\",\n            fn: async (players) => {\n                for (const player of players) {\n                    const properties = player.properties.filter((p) => p.level < p.maxLevel);\n                    if (properties.length === 0) {\n                        continue;\n                    }\n                    const randomProperty = properties[Math.floor(Math.random() * properties.length)];\n                    await randomProperty.levelUp();\n                }\n            }\n        },\n        {\n            id: \"build-down\", name: \"éšæœºé™ä½ä¸€æ ‹å»ºç­‘çš„ç­‰çº§\", desc: \"ç©å®¶éšæœºé™ä½ä¸€æ ‹å»ºç­‘çš„ç­‰çº§\",\n            fn: async (players) => {\n                for (const player of players) {\n                    const properties = player.properties.filter((p) => p.level > 0);\n                    if (properties.length === 0) {\n                        continue;\n                    }\n                    const randomProperty = properties[Math.floor(Math.random() * properties.length)];\n                    await randomProperty.levelDown();\n                }\n            }\n        },\n        {\n            id: \"gain-card\", name: \"éšæœºè·å¾—ä¸€å¼ æœºä¼šå¡\", desc: \"ç©å®¶éšæœºè·å¾—ä¸€å¼ æœºä¼šå¡\",\n            fn: async (players) => {\n                const cardSourceIdList = Array.from(gameProcess.chanceCardInfos.keys());\n                for (const player of players) {\n                    const newCard = gameProcess.createNewChanceCard(cardSourceIdList[Math.floor(Math.random() * cardSourceIdList.length)]);\n                    await player.gainCard(newCard);\n                }\n            }\n        },\n        {\n            id: \"stock-surge\", name: \"è‚¡ç¥¨æš´æ¶¨\", desc: \"éšæœºä¸€åªè‚¡ç¥¨å¤§å¹…ä¸Šæ¶¨ï¼ŒæŒæœ‰äººèººèµš\",\n            fn: async (players) => {\n                const stockMarket = gameProcess.stockMarket;\n                const stocks = stockMarket.data.stocks;\n                if (stocks.length === 0) return;\n                const randomStock = stocks[Math.floor(Math.random() * stocks.length)];\n                stockMarket.triggerEvent(randomStock.id, 'RANDOM', 3);\n            }\n        },\n        {\n            id: \"stock-crash\", name: \"è‚¡å¸‚å´©ç›˜\", desc: \"å¸‚åœºè½¬å…¥ç†Šå¸‚ï¼Œæ‰€æœ‰è‚¡ç¥¨ä¸‹è·Œ\",\n            fn: async (players) => {\n                const stockMarket = gameProcess.stockMarket;\n                stockMarket.setMarketTrend(-0.8);\n                for (const stock of stockMarket.data.stocks) {\n                    stockMarket.triggerEvent(stock.id, 'RANDOM', 3);\n                }\n            }\n        },\n        {\n            id: \"force-buy\", name: \"å¼ºåˆ¶ä¹°å…¥\", desc: \"å¼ºåˆ¶ä¹°å…¥ä¸€åªéšæœºè‚¡ç¥¨\",\n            fn: async (players) => {\n                const stockMarket = gameProcess.stockMarket;\n                const stocks = stockMarket.data.stocks;\n                if (stocks.length === 0) return;\n                const randomStock = stocks[Math.floor(Math.random() * stocks.length)];\n                for (const p of players) {\n                    const budget = Math.floor(p.money / 5);\n                    const maxAmount = Math.floor(budget / (randomStock.price * (1 + stockMarket.getTaxRate(true))));\n                    if (maxAmount <= 0) continue;\n                    const amount = Math.min(maxAmount, 100);\n                    const canTradeRes = stockMarket.canTrade(p.id, randomStock.id, amount, true);\n                    if (!canTradeRes.ok) continue;\n                    const receipt = stockMarket.commitBuy(p.id, randomStock.id, amount);\n                    if (receipt) {\n                        await p.cost(receipt.totalCost);\n                    }\n                }\n            }\n        },\n        {\n            id: \"force-sell\", name: \"å¼ºåˆ¶å¹³ä»“\", desc: \"éšæœºå–æ‰ä¸€åŠæŒä»“\",\n            fn: async (players) => {\n                const stockMarket = gameProcess.stockMarket;\n                for (const p of players) {\n                    const holdings = stockMarket.getPlayerHoldingStock(p.id).filter(r => r.holding > 0);\n                    if (holdings.length === 0) continue;\n                    const randomHolding = holdings[Math.floor(Math.random() * holdings.length)];\n                    const sellAmount = Math.floor(randomHolding.holding / 2);\n                    if (sellAmount <= 0) continue;\n                    const canTradeRes = stockMarket.canTrade(p.id, randomHolding.stock.id, sellAmount, false);\n                    if (!canTradeRes.ok) continue;\n                    const receipt = stockMarket.commitSell(p.id, randomHolding.stock.id, sellAmount);\n                    if (receipt) {\n                        await p.gain(receipt.totalCost);\n                    }\n                }\n            }\n        }\n    ];\n    const res = await gameProcess.showItemSelectDialog(player.id, {\n        title: \"é­”æ³•å±‹\",\n        content: \"é€‰æ‹©ä¸€ä¸ªæ•ˆæœï¼Œä¼šä½œç”¨äºéšæœºçš„ç©å®¶\",\n        cancelText: \"ä¸é€‰\",\n        itemList: events.map(e => ({\n            id: e.id,\n            display: e.desc\n        }))\n    });\n\n    if (res.selected && res.selected.length > 0) {\n        const selectedEvent = events.find((e => e.id === res.selected[0])) || events[0];\n        const randowTargetRange = targetFilter[Math.floor(Math.random() * targetFilter.length)]\n        const randomTargets = randowTargetRange.filter(Array.from(gameProcess.players.values()));\n\n        await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n            title: `${player.name} é­”æ³•å±‹é€‰æ‹©ç»“æœ`,\n            content: {\n                \"id\": \"event-info-container\",\n                \"type\": \"div\",\n                \"style\": {\n                    \"display\": \"flex\",\n                    \"flexDirection\": \"column\",\n                    \"gap\": \"0.5rem\",\n                    \"maxWidth\": \"30rem\"\n                },\n                \"children\": [\n                    {\n                        \"id\": \"event-title-row\",\n                        \"type\": \"div\",\n                        \"style\": {\n                            \"display\": \"flex\",\n                            \"flexDirection\": \"row\",\n                            \"alignItems\": \"baseline\",\n                            \"gap\": \"0.25rem\"\n                        },\n                        \"children\": [\n                            {\n                                \"id\": \"event-name\",\n                                \"type\": \"text\",\n                                \"content\": selectedEvent.name,\n                                \"style\": {\n                                    \"fontSize\": \"1.125rem\",\n                                    \"fontWeight\": \"bold\",\n                                    \"color\": \"var(--color-primary)\"\n                                }\n                            },\n                            {\n                                \"id\": \"event-range\",\n                                \"type\": \"text\",\n                                \"content\": `èŒƒå›´: ${randowTargetRange.name}`,\n                                \"style\": {\n                                    \"fontSize\": \"1.125rem\",\n                                    \"fontWeight\": \"bold\",\n                                    \"color\": \"#333333\"\n                                }\n                            }\n                        ]\n                    },\n                    {\n                        \"id\": \"player-label\",\n                        \"type\": \"text\",\n                        \"content\": \"æ¶‰åŠçš„ç©å®¶:\",\n                        \"style\": {\n                            \"fontSize\": \"0.875rem\",\n                            \"color\": \"#666666\",\n                            \"fontWeight\": \"600\"\n                        }\n                    },\n                    {\n                        \"id\": \"player-list\",\n                        \"type\": \"text\",\n                        \"content\": randomTargets.length > 0 ? randomTargets.map(p => p.name).join('ã€') : 'æ— ',\n                        \"style\": {\n                            \"fontSize\": \"1rem\",\n                            \"color\": \"#495057\"\n                        }\n                    }\n                ]\n            },\n            duration: 3500\n        })\n\n        if (randomTargets.length > 0) {\n            await selectedEvent.fn(randomTargets);\n        } else {\n            gameProcess.msgNotifyBroadcast(\"warning\", \"æ²¡æœ‰ç¬¦åˆæ¡ä»¶çš„ç©å®¶!\");\n        }\n    }\n\n\n});\n"},{"id":"event-g66ur7","name":"å½©ç¥¨","description":"ç»è¿‡å¯è´­ä¹°å½©ç¥¨ï¼Œæ¯äººæ¯æ¬¡æœ€å¤š3å¼ ï¼Œæ¯å‘¨ä¸€å¼€å¥–","type":"PassedEvent","iconId":"image-wwt70o","properties":[],"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess) => {\n    const lotteryManager = gameProcess.lotteryManager;\n    const res = await gameProcess.showItemSelectDialog(player.id, {\n        title: \"è´­ä¹°å½©ç¥¨\",\n        content: `é€‰æ‹©å¿ƒæ„çš„å·ç è´­ä¹°å½©ç¥¨ï¼ˆæ¯äººæ¯æ¬¡æœ€å¤š3å¼ ï¼Œæ¯å¼ ${lotteryManager.price}å…ƒï¼‰ï¼Œæ¯å‘¨ä¸€å¼€å¥–\\nå½“å‰å¥–æ± : ${lotteryManager.currentJackpot}å…ƒ`,\n        cancelText: \"ä¸ä¹°\",\n        multiple: 3,\n        column: 5,\n        itemList: lotteryManager.stock.map(l => ({\n            id: `${l}`,\n            display: `${l}`,\n        }))\n    });\n    console.log(res);\n    await gameProcess.handleBuyLottery(player, res.selected.map(s => Number(s)));\n});"},{"id":"event-o5hqij","name":"ç›‘ç‹±","description":"ç›‘ç‹±","type":"ArrivedEvent","iconId":"image-ijf8tf","properties":[],"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess) => {\r\n  player;\r\n});"},{"id":"event-uodz4z","name":"éšæœºäº‹ä»¶","description":"è§¦å‘éšæœºçš„äº‹ä»¶","type":"ArrivedEvent","iconId":"image-a63ig8","properties":[],"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess) => {\n  interface RandomEvent {\n    id: string;\n    name: string;\n    desc: string;\n    type: 'good' | 'bad' | 'neutral';\n    weight: number;\n    fn: () => Promise<void>;\n  }\n\n  const allPlayers: IPlayer[] = Array.from(gameProcess.players.values());\n  const mapSize = gameProcess.getPathMapItemIds().length;\n  const pathMapItemIds = gameProcess.getPathMapItemIds();\n\n  // ===== äº‹ä»¶æ± å®šä¹‰ =====\n  const events: RandomEvent[] = [\n    // --- æ­£é¢äº‹ä»¶ (æ€»æƒé‡ 45) ---\n    {\n      id: \"fortune-rain\",\n      name: \"å¤©é™æ¨ªè´¢\",\n      desc: \"è´¢ç¥çœ·é¡¾ï¼Œè·å¾— 1000~5000 å…ƒ\",\n      type: \"good\",\n      weight: 10,\n      fn: async () => {\n        const amount = Math.floor(Math.random() * 4000 + 1000);\n        await player.gain(amount);\n        gameProcess.msgNotifyBroadcast(\"success\", `${player.name} å¤©é™æ¨ªè´¢ï¼Œè·å¾— ${amount} å…ƒï¼`);\n      }\n    },\n    {\n      id: \"stock-tip\",\n      name: \"è‚¡å¸‚å†…å¹•\",\n      desc: \"è·å¾—ä¸€åªè‚¡ç¥¨çš„å†…å¹•æ¶ˆæ¯\",\n      type: \"good\",\n      weight: 7,\n      fn: async () => {\n        const result = await gameProcess.peekStockTrend(player.id, {\n          title: \"è‚¡å¸‚å†…å¹•\",\n          content: \"æœ‰äººå·å·å‘Šè¯‰ä½ ä¸‹å‘¨è‚¡å¸‚çš„é£å‘...\"\n        });\n        if (result) {\n          gameProcess.messageNotify([player.id], { type: \"info\", content: `å†…å¹•æ¶ˆæ¯ï¼š${result.stockName} è¢«è¯„çº§ä¸ºã€Œ${result.rating}ã€ï¼` });\n        }\n      }\n    },\n    {\n      id: \"free-card\",\n      name: \"æ„å¤–ä¹‹å–œ\",\n      desc: \"éšæœºè·å¾—ä¸€å¼ æœºä¼šå¡\",\n      type: \"good\",\n      weight: 8,\n      fn: async () => {\n        const cardIds = Array.from(gameProcess.chanceCardInfos.keys());\n        if (cardIds.length === 0) return;\n        const randomCardId = cardIds[Math.floor(Math.random() * cardIds.length)];\n        const newCard = gameProcess.createNewChanceCard(randomCardId);\n        await player.gainCard(newCard);\n        gameProcess.msgNotifyBroadcast(\"success\", `${player.name} æ¡åˆ°äº†ä¸€å¼ æœºä¼šå¡ï¼`);\n      }\n    },\n    {\n      id: \"building-gift\",\n      name: \"å»ºç­‘å‡çº§\",\n      desc: \"éšæœºä¸€æ ‹å»ºç­‘è‡ªåŠ¨å‡çº§\",\n      type: \"good\",\n      weight: 7,\n      fn: async () => {\n        const upgradeable = player.properties.filter(p => p.level < p.maxLevel);\n        if (upgradeable.length === 0) {\n          gameProcess.messageNotify([player.id], { type: \"warning\", content: \"ä½ æ²¡æœ‰å¯å‡çº§çš„å»ºç­‘ï¼\" });\n          return;\n        }\n        const randomProperty = upgradeable[Math.floor(Math.random() * upgradeable.length)];\n        await randomProperty.levelUp();\n        gameProcess.msgNotifyBroadcast(\"success\", `${player.name} çš„ ${randomProperty.name} è‡ªåŠ¨å‡çº§ï¼`);\n      }\n    },\n    {\n      id: \"lottery-blessing\",\n      name: \"å½©ç¥¨ç¥ç¦\",\n      desc: \"è·å¾—ä¸€å¼ å…è´¹å½©ç¥¨\",\n      type: \"good\",\n      weight: 6,\n      fn: async () => {\n        const stock = gameProcess.lotteryManager.stock;\n        if (stock.length === 0) return;\n        const randomLottery = stock[Math.floor(Math.random() * stock.length)];\n        await gameProcess.handleBuyLottery(player, [randomLottery]);\n        gameProcess.msgNotifyBroadcast(\"success\", `${player.name} è·å¾—ä¸€å¼ å…è´¹å½©ç¥¨ï¼`);\n      }\n    },\n    {\n      id: \"wealth-share\",\n      name: \"å‡å¯Œæ•ˆåº”\",\n      desc: \"æ‰€æœ‰ç©å®¶ç»™ä½ æ¯äºº 200 å…ƒ\",\n      type: \"good\",\n      weight: 7,\n      fn: async () => {\n        const otherPlayers = allPlayers.filter(p => (!p.isBankrupted && (p.id !== player.id)));\n        if (otherPlayers.length === 0) return;\n        let totalGain = 0;\n        for (const other of otherPlayers) {\n          if (other.money >= 200) {\n            await other.cost(200, \"event\", player);\n            await player.gain(200, \"event\", other);\n            totalGain += 200;\n          }\n        }\n        if (totalGain > 0) {\n          gameProcess.msgNotifyBroadcast(\"success\", `${player.name} è·å¾—å‡å¯Œæ•ˆåº”ï¼Œæ€»è®¡ ${totalGain} å…ƒï¼`);\n        }\n      }\n    },\n    // --- è´Ÿé¢äº‹ä»¶ (æ€»æƒé‡ 35) ---\n    {\n      id: \"sudden-loss\",\n      name: \"æ„å¤–æŸå¤±\",\n      desc: \"é­é‡æ„å¤–ï¼Œå¤±å» 1000~3000 å…ƒ\",\n      type: \"bad\",\n      weight: 10,\n      fn: async () => {\n        const amount = Math.floor(Math.random() * 2000 + 1000);\n        if (player.money < amount) {\n          gameProcess.messageNotify([player.id], { type: \"warning\", content: \"ä½ é­é‡æ„å¤–ï¼Œä½†ä½ èº«æ— åˆ†æ–‡...\" });\n          return;\n        }\n        await player.cost(amount);\n        gameProcess.msgNotifyBroadcast(\"error\", `${player.name} é­é‡æ„å¤–ï¼ŒæŸå¤± ${amount} å…ƒï¼`);\n      }\n    },\n    {\n      id: \"building-damage\",\n      name: \"å»ºç­‘æŸå\",\n      desc: \"éšæœºä¸€æ ‹å»ºç­‘ç­‰çº§ä¸‹é™\",\n      type: \"bad\",\n      weight: 7,\n      fn: async () => {\n        const damagable = player.properties.filter(p => p.level > 0);\n        if (damagable.length === 0) {\n          gameProcess.messageNotify([player.id], { type: \"warning\", content: \"å¹¸è¿çš„æ˜¯ï¼Œä½ æ²¡æœ‰å»ºç­‘å¯æŸåï¼\" });\n          return;\n        }\n        const randomProperty = damagable[Math.floor(Math.random() * damagable.length)];\n        await randomProperty.levelDown();\n        gameProcess.msgNotifyBroadcast(\"error\", `${player.name} çš„ ${randomProperty.name} é­åˆ°æŸåï¼`);\n      }\n    },\n    {\n      id: \"forced-donation\",\n      name: \"å¼ºåˆ¶ææ¬¾\",\n      desc: \"è¢«è¿«æå‡ºç°é‡‘çš„ 10%\",\n      type: \"bad\",\n      weight: 6,\n      fn: async () => {\n        const donation = Math.floor(player.money * 0.1);\n        if (donation <= 0) return;\n        await player.cost(donation);\n        gameProcess.msgNotifyBroadcast(\"warning\", `${player.name} è¢«å¼ºåˆ¶ææ¬¾ ${donation} å…ƒï¼`);\n      }\n    },\n    // {\n    //   id: \"time-reversal\",\n    //   name: \"æ—¶ä¹‹é€†æµ\",\n    //   desc: \"è¢«æ—¶å…‰å€’æµï¼Œåé€€ 2-4 æ­¥\",\n    //   type: \"bad\",\n    //   weight: 7,\n    //   fn: async () => {\n    //     const steps = Math.floor(Math.random() * 3) + 2;\n    //     await player.tp(Math.max(0, player.positionIndex - steps));\n    //     gameProcess.msgNotifyBroadcast(\"warning\", `${player.name} è¢«æ—¶ä¹‹é€†æµå½±å“ï¼Œåé€€ ${steps} æ­¥ï¼`);\n    //   }\n    // },\n    {\n      id: \"card-loss\",\n      name: \"å¡ç‰‡é—å¤±\",\n      desc: \"éšæœºå¤±å»ä¸€å¼ æœºä¼šå¡\",\n      type: \"bad\",\n      weight: 5,\n      fn: async () => {\n        if (player.chanceCards.length === 0) {\n          gameProcess.messageNotify([player.id], { type: \"warning\", content: \"ä½ æ²¡æœ‰æœºä¼šå¡å¯ä¸¢å¤±ï¼\" });\n          return;\n        }\n        const randomCard = player.chanceCards[Math.floor(Math.random() * player.chanceCards.length)];\n        await player.loseCard(randomCard.getId());\n        gameProcess.msgNotifyBroadcast(\"error\", `${player.name} é—å¤±äº†æœºä¼šå¡ ${randomCard.getName()}ï¼`);\n      }\n    },\n    // --- ä¸­æ€§/äº’åŠ¨äº‹ä»¶ (æ€»æƒé‡ 20) ---\n    {\n      id: \"random-tp\",\n      name: \"æ—¶ç©ºä¼ é€\",\n      desc: \"éšæœºä¼ é€åˆ°åœ°å›¾æŸå¤„\",\n      type: \"neutral\",\n      weight: 10,\n      fn: async () => {\n        if (mapSize <= 1) return;\n        let targetPos = pathMapItemIds[Math.floor(Math.random() * mapSize)];\n        while (targetPos === player.positionMapItemId) {\n          targetPos = pathMapItemIds[Math.floor(Math.random() * mapSize)];\n        }\n        await player.tpToMapItem(targetPos);\n        gameProcess.msgNotifyBroadcast(\"info\", `${player.name} è¢«éšæœºä¼ é€åˆ°ä½ç½® ${targetPos}ï¼`);\n      }\n    },\n    {\n      id: \"card-steal\",\n      name: \"å€ŸèŠ±çŒ®ä½›\",\n      desc: \"ä»éšæœºç©å®¶å·ä¸€å¼ æœºä¼šå¡\",\n      type: \"neutral\",\n      weight: 5,\n      fn: async () => {\n        const otherPlayers = allPlayers.filter(p => (!p.isBankrupted && (p.id !== player.id)));\n        if (otherPlayers.length === 0) {\n          gameProcess.messageNotify([player.id], { type: \"warning\", content: \"æ²¡æœ‰å¯å·çš„ç›®æ ‡ï¼\" });\n          return;\n        }\n        const target = otherPlayers[Math.floor(Math.random() * otherPlayers.length)];\n        const stolenCard = target.chanceCards[Math.floor(Math.random() * target.chanceCards.length)];\n        await target.loseCard(stolenCard.getId());\n        await player.gainCard(gameProcess.createNewChanceCard(stolenCard.getSourceId()));\n        gameProcess.msgNotifyBroadcast(\"info\", `${player.name} ä» ${target.name} é‚£å·èµ°äº† ${stolenCard.getName()}ï¼`);\n      }\n    },\n    {\n      id: \"swap-fortune\",\n      name: \"è´¢å¯Œå¹³å‡\",\n      desc: \"ä¸éšæœºç©å®¶å¹³åˆ†ç°é‡‘\",\n      type: \"neutral\",\n      weight: 5,\n      fn: async () => {\n        const otherPlayers = allPlayers.filter(p => (!p.isBankrupted && (p.id !== player.id)));\n        if (otherPlayers.length === 0) return;\n        const target = otherPlayers[Math.floor(Math.random() * otherPlayers.length)];\n        const playerMoney = player.money || 0;\n        const targetMoney = target.money || 0;\n        const avg = Math.floor((playerMoney + targetMoney) / 2);\n        const diff = playerMoney - avg;\n        if (diff > 0) {\n          await player.cost(diff, \"event\", target);\n          await target.gain(diff, \"event\", player);\n        } else if (diff < 0) {\n          await target.cost(-diff, \"event\", player);\n          await player.gain(-diff, \"event\", target);\n        }\n        gameProcess.msgNotifyBroadcast(\"info\", `${player.name} ä¸ ${target.name} çš„ç°é‡‘è¢«å¹³å‡ä¸º ${avg} å…ƒï¼`);\n      }\n    }\n  ];\n\n  // ===== æŒ‰æƒé‡éšæœºé€‰æ‹©äº‹ä»¶ =====\n  const totalWeight = events.reduce((sum, e) => sum + e.weight, 0);\n  let random = Math.random() * totalWeight;\n  let selectedEvent = events[0];\n  for (const event of events) {\n    random -= event.weight;\n    if (random <= 0) {\n      selectedEvent = event;\n      break;\n    }\n  }\n\n  // ===== æ˜¾ç¤ºäº‹ä»¶åŠ¨ç”» =====\n  const typeEmoji = selectedEvent.type === 'good' ? 'star' : selectedEvent.type === 'bad' ? 'boom' : 'cycle';\n  const typeColor = selectedEvent.type === 'good' ? '#52c41a' : selectedEvent.type === 'bad' ? '#ff4d4f' : '#1890ff';\n\n  await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n    title: `${typeEmoji} éšæœºäº‹ä»¶è§¦å‘`,\n    content: {\n      id: \"random-event-display\",\n      type: \"div\",\n      style: {\n        display: \"flex\",\n        flexDirection: \"column\",\n        alignItems: \"center\",\n        gap: \"0.75rem\",\n        padding: \"1rem\"\n      },\n      children: [\n        {\n          id: \"event-name\",\n          type: \"text\",\n          content: selectedEvent.name,\n          style: {\n            fontSize: \"1.5rem\",\n            fontWeight: \"bold\",\n            color: typeColor\n          }\n        },\n        {\n          id: \"event-desc\",\n          type: \"text\",\n          content: selectedEvent.desc,\n          style: {\n            fontSize: \"1rem\",\n            color: \"#666\"\n          }\n        },\n        {\n          id: \"player-name\",\n          type: \"text\",\n          content: `â€” ${player.name} â€”`,\n          style: {\n            fontSize: \"1.125rem\",\n            fontWeight: \"600\",\n            color: \"#333\"\n          }\n        }\n      ]\n    },\n    duration: 3000\n  });\n\n  // ===== æ‰§è¡Œäº‹ä»¶æ•ˆæœ =====\n  await selectedEvent.fn();\n})"},{"id":"event-z25j74","name":"åç‰¢","description":"ä¼ é€åˆ°ç›‘ç‹±","type":"ArrivedEvent","iconId":"image-je466j","properties":[],"effectCode":"(async (player: IPlayer, gameProcess: IGameProcess) => {\n  const prisonMapItemId = \"mi-3pzykz\";\n  if (!gameProcess.mapData.mapItems.some((mapItem) => mapItem.id === prisonMapItemId)) {\n    throw new Error(\"ç›‘ç‹±ç›®æ ‡åœ°å›¾é¡¹ä¸å­˜åœ¨\");\n  }\n  if (!player.tpToMapItem) {\n    throw new Error(\"æ–°ç‰ˆ MapPath ä¼ é€ API ä¸å¯ç”¨\");\n  }\n  await player.tpToMapItem(prisonMapItemId);\n  player.setStop(player.stop + 1);\n});"}],"phases":{"gameOverRule":[{"id":"phase-p0mtrp","name":"æ¸¸æˆç»“æŸåˆ¤å®šè§„åˆ™","description":"æ¸¸æˆç»“æŸåˆ¤å®šè§„åˆ™, è¿”å›ä¸€ä¸ªå¸ƒå°”å€¼, å½“è¿”å›å€¼ä¸ºtrueæ—¶æ¸¸æˆç»“æŸ","from":"ç³»ç»Ÿ","mark":0,"initEventCode":"(async (context: GameContext, gameProcess: IGameProcess) => {\n    const players = Array.from(gameProcess.players.values());\n    if (players.length <= 1) return false;\n    const activePlayers = players.filter(p => !p.isBankrupted);\n    if (activePlayers.length <= 1) {\n        const allPlayers = Array.from(gameProcess.players.values());\n        allPlayers.sort((a, b) => (b.money ?? 0) - (a.money ?? 0));\n        return allPlayers.map(p => p.id);\n    }\n    if (players.some(p => p.money >= gameProcess.gameSetting.targetMoney.value)) {\n        const allPlayers = Array.from(gameProcess.players.values());\n        allPlayers.sort((a, b) => (b.money ?? 0) - (a.money ?? 0));\n        return allPlayers.map(p => p.id);\n    }\n    return false;\n});"}],"gameInited":[{"id":"phase-2uwazh","name":"æ¸¸æˆåˆå§‹åŒ–ç»“æŸ","description":"æ¸¸æˆåˆå§‹åŒ–ç»“æŸé˜¶æ®µ","from":"ç³»ç»Ÿ","mark":0,"initEventCode":"((ctx: GameContext, gameProcess: IGameProcess) => {\n    gameProcess.players.forEach((player) => {\n        gameProcess.registerPlayerButton(player.id, \"æŸ¥çœ‹æŒè‚¡\", async () => {\n            const playerId = player.id;\n            const portfolios = gameProcess.exportData.stockMarket.portfolios[playerId] || {};\n            const stocks = gameProcess.exportData.stockMarket.stocks;\n\n            // é¢„å…ˆè®¡ç®—æŒä»“æ•°æ®\n            const holdings = [];\n            for (const stock of stocks) {\n                const holding = portfolios[stock.id] || 0;\n                if (holding > 0) {\n                    holdings.push({\n                        name: stock.name,\n                        color: stock.color,\n                        price: stock.price,\n                        priceText: stock.display.price,\n                        percent: stock.display.percent,\n                        percentColor: stock.display.color,\n                        linePath: stock.display.linePath,\n                        areaPath: stock.display.areaPath,\n                        holding: holding,\n                        marketValue: Math.round(holding * stock.price)\n                    });\n                }\n            }\n\n            await gameProcess.showConfirmDialog(playerId, {\n                title: `${player.name} çš„è‚¡ç¥¨æŒä»“`,\n                content: {\n                    id: \"stock-portfolio-wrapper\",\n                    type: \"div\",\n                    variable: {\n                        holdings: holdings,\n                        hasHolding: holdings.length > 0\n                    },\n                    children: [$ui__stock_portfolio]\n                },\n            });\n        });\n    });\n});"},{"id":"phase-mgdvg8","name":"è‚¡å¸‚ç³»ç»Ÿåˆå§‹åŒ–","description":"è‚¡å¸‚ç³»ç»Ÿåˆå§‹åŒ–ï¼šæ ¹æ®åœ°çš®å…¬å¸è‡ªåŠ¨åˆ›å»ºè‚¡ç¥¨ï¼Œæ³¨å†Œåœ°çš®-è‚¡ç¥¨è”åŠ¨ä¿®é¥°å™¨ï¼ˆæ”¶ç§Ÿ/å‡çº§/é™çº§/è´­ä¹°ï¼‰","from":"ç³»ç»Ÿ","initEventCode":"(async (context, gameProcess) => {\n    class StockMarketManager implements IStockMarketManager {\n        private _data: StockMarketData;\n        private historyLimit = 20;\n        private readonly BUY_FEE_RATE = 0.01;\n        private readonly SELL_FEE_RATE = 0.01;\n        private readonly UI_CONFIG = { width: 100, height: 30, padding: 4 };\n\n        constructor() {\n            this._data = {\n                isOpen: false,\n                stocks: [],\n                portfolios: {},\n                marketTrend: 0,\n                volatilityMultiplier: 1,\n                tick: 0\n            };\n        }\n\n        get data(): StockMarketData { return this._data; }\n\n        public init(configs: StockConfig[]): void {\n            if (this._data.stocks.length > 0) return;\n            this._data.stocks = configs.map(c => this.createStockInstance(c));\n            this._data.isOpen = true;\n        }\n\n        public addStock(config: StockConfig): Stock | null {\n            if (this.getStock(config.id)) return this.getStock(config.id)!;\n            const stock = this.createStockInstance(config);\n            this._data.stocks.push(stock);\n            return stock;\n        }\n\n        private createStockInstance(config: StockConfig): Stock {\n            const price = config.price ?? 100;\n            const stock: Stock = {\n                id: config.id,\n                name: config.name,\n                color: config.color || '#fff',\n                price,\n                basePrice: config.basePrice ?? price,\n                changeRate: 0,\n                history: [price],\n                trend: config.initialTrend ?? 0,\n                volatility: config.volatility ?? 0.02,\n                trendSpeed: config.trendSpeed ?? 0.01,\n                liquidity: config.liquidity ?? 1,\n                heat: 0,\n                display: {\n                    color: '#999999',\n                    linePath: '',\n                    areaPath: '',\n                    price: '',\n                    percent: ''\n                }\n            };\n            this.refreshDisplay(stock);\n            return stock;\n        }\n\n        public tick(): void {\n            this._data.tick++;\n            for (const stock of this._data.stocks) {\n                stock.trend += (Math.random() - 0.5) * stock.trendSpeed;\n                stock.trend += this._data.marketTrend * 0.1;\n                stock.trend = this.clamp(stock.trend, -1, 1);\n                stock.heat *= 0.9;\n                let rate = stock.trend * 0.02\n                    + (Math.random() - 0.5) * stock.volatility * this._data.volatilityMultiplier;\n                rate *= (1 + stock.heat);\n                this.applyPriceChange(stock, rate);\n            }\n        }\n\n        public setMarketTrend(value: number): void {\n            this._data.marketTrend = this.clamp(value, -1, 1);\n        }\n\n        public setHistoryLimit(limit: number): void {\n            if (limit > 0) {\n                this.historyLimit = limit;\n                for (const s of this._data.stocks) {\n                    while (s.history.length > this.historyLimit) s.history.shift();\n                }\n            }\n        }\n\n        public getTaxRate(isBuy: boolean): number {\n            return isBuy ? this.BUY_FEE_RATE : this.SELL_FEE_RATE;\n        }\n\n        public getStock(stockId: string): Stock | undefined {\n            return this._data.stocks.find(s => s.id === stockId);\n        }\n\n        public getHolding(playerId: string, stockId: string): number {\n            return this._data.portfolios[playerId]?.[stockId] || 0;\n        }\n\n        public getPlayerHoldingStock(playerId: string): { stock: Stock; holding: number }[] {\n            const h = this._data.portfolios[playerId];\n            if (!h) return [];\n            return Object.keys(h)\n                .filter(id => h[id] > 0)\n                .map(id => ({ stock: this.getStock(id)!, holding: h[id] }));\n        }\n\n        public getTransactionCost(stockId: string, amount: number): number {\n            const s = this.getStock(stockId);\n            if (!s) return 0;\n            return Math.round(s.price * amount * (1 + this.getTaxRate(true)));\n        }\n\n        public getSellRevenue(stockId: string, amount: number): number {\n            const s = this.getStock(stockId);\n            if (!s) return 0;\n            return Math.round(s.price * amount * (1 - this.getTaxRate(false)));\n        }\n\n        public canTrade(playerId: string, stockId: string, amount: number, isBuy: boolean): TradeCheckResult {\n            if (!this._data.isOpen) return { ok: false, msg: 'ä¼‘å¸‚' };\n            const s = this.getStock(stockId);\n            if (!s) return { ok: false };\n            if (amount <= 0) return { ok: false };\n            if (!isBuy && this.getHolding(playerId, stockId) < amount) {\n                return { ok: false, msg: 'æŒæœ‰çš„è‚¡ç¥¨æ•°ä¸å¤Ÿ' };\n            }\n            return { ok: true };\n        }\n\n        public commitBuy(playerId: string, stockId: string, amount: number): TradeReceipt | null {\n            const check = this.canTrade(playerId, stockId, amount, true);\n            if (!check.ok) return null;\n            const s = this.getStock(stockId)!;\n            if (!this._data.portfolios[playerId]) this._data.portfolios[playerId] = {};\n            this._data.portfolios[playerId][stockId] = (this._data.portfolios[playerId][stockId] || 0) + amount;\n            this.applyTradeImpact(s, amount, s.price, true);\n            const feeRate = this.getTaxRate(true);\n            return { stockName: s.name, price: s.price, amount, totalCost: Math.round(s.price * amount * (1 + feeRate)) };\n        }\n\n        public commitSell(playerId: string, stockId: string, amount: number): TradeReceipt | null {\n            const check = this.canTrade(playerId, stockId, amount, false);\n            if (!check.ok) return null;\n            const s = this.getStock(stockId)!;\n            const port = this._data.portfolios[playerId];\n            if (!port) return null;\n            port[stockId] -= amount;\n            if (port[stockId] <= 0) delete port[stockId];\n            this.applyTradeImpact(s, amount, s.price, false);\n            const feeRate = this.getTaxRate(false);\n            return { stockName: s.name, price: s.price, amount, totalCost: Math.round(s.price * amount * (1 - feeRate)) };\n        }\n\n        private applyTradeImpact(stock: Stock, amount: number, price: number, isBuy: boolean) {\n            const tradeValue = amount * price;\n            let impact = Math.log10(tradeValue + 1) * 0.001 * (1 / stock.liquidity);\n            impact *= Math.sqrt(Math.log10(tradeValue + 1));\n            if (!isBuy) impact *= -1;\n            stock.heat += Math.log10(tradeValue + 1) * 0.01;\n            this.applyPriceChange(stock, impact);\n        }\n\n        public triggerEvent(stockId: string, type: 'RENT' | 'BUILD' | 'RANDOM', intensity: number = 1): void {\n            const s = this.getStock(stockId);\n            if (!s) return;\n            let rate = 0;\n            if (type === 'RENT') {\n                rate = 0.01 * intensity;\n                s.trend += 0.1;\n            } else if (type === 'BUILD') {\n                rate = 0.05 * intensity;\n                s.heat += 0.2;\n            } else {\n                rate = (Math.random() - 0.5) * 0.05;\n            }\n            this.applyPriceChange(s, rate);\n        }\n\n        private applyPriceChange(stock: Stock, rate: number) {\n            const old = stock.price;\n            let newPrice = stock.price * (1 + rate);\n            newPrice = this.clamp(newPrice, 5, 100000);\n            stock.price = Number(newPrice.toFixed(2));\n            stock.changeRate = (stock.price - old) / old;\n            stock.history.push(stock.price);\n            if (stock.history.length > this.historyLimit) stock.history.shift();\n        }\n\n        public getExportData(): StockMarketData {\n            this._data.stocks.forEach(s => this.refreshDisplay(s));\n            return this._data;\n        }\n\n        private refreshDisplay(stock: Stock): void {\n            stock.display.color = stock.changeRate >= 0 ? '#ef4444' : '#22c55e';\n            stock.display.price = stock.price.toFixed(1);\n            const percent = (stock.changeRate * 100).toFixed(1);\n            stock.display.percent = (stock.changeRate > 0 ? '+' : '') + percent + '%';\n            const history = stock.history;\n            if (history.length < 2) {\n                const midY = this.UI_CONFIG.height / 2;\n                const line = \"M0,\" + midY + \" L\" + this.UI_CONFIG.width + \",\" + midY;\n                stock.display.linePath = line;\n                stock.display.areaPath = line + \" L\" + this.UI_CONFIG.width + \",\" + this.UI_CONFIG.height + \" L0,\" + this.UI_CONFIG.height + \" Z\";\n                return;\n            }\n            const min = Math.min.apply(null, history);\n            const max = Math.max.apply(null, history);\n            const range = max - min || 1;\n            const drawHeight = this.UI_CONFIG.height - this.UI_CONFIG.padding * 2;\n            const stepX = this.UI_CONFIG.width / (history.length - 1);\n            const points: string[] = [];\n            for (let i = 0; i < history.length; i++) {\n                const x = (i * stepX).toFixed(1);\n                const ratio = (history[i] - min) / range;\n                const y = (this.UI_CONFIG.height - this.UI_CONFIG.padding - (ratio * drawHeight)).toFixed(1);\n                points.push(x + \",\" + y);\n            }\n            const line = \"M\" + points.join(\" L\");\n            stock.display.linePath = line;\n            stock.display.areaPath = line + \" L\" + this.UI_CONFIG.width + \",\" + this.UI_CONFIG.height + \" L0,\" + this.UI_CONFIG.height + \" Z\";\n        }\n\n        private clamp(v: number, min: number, max: number): number {\n            return Math.max(min, Math.min(max, v));\n        }\n    }\n\n    const stockMarket = new StockMarketManager();\n\n    // ========== æ ¹æ®åœ°çš®å…¬å¸åˆ›å»ºè‚¡ç¥¨ ==========\n    const companyColors: Record<string, string> = {\n        'å†…å·çŸ¿ä¸š': '#8B6914',\n        'èººå¹³åœ°äº§': '#2D8B57',\n        'éŸ­èœå•†è¡Œ': '#C8A415',\n        'æ‘¸é±¼ç§‘æŠ€': '#4682B4',\n        'æ¢­å“ˆèµ„æœ¬': '#C0392B'\n    };\n\n    const companyMap: Record<string, IProperty[]> = {};\n    gameProcess.properties.forEach(function(prop) {\n        const company = prop.company;\n        if (!company) return;\n        if (!companyMap[company]) companyMap[company] = [];\n        companyMap[company].push(prop);\n    });\n\n    const stockConfigs: StockConfig[] = [];\n    const companyKeys = Object.keys(companyMap);\n    for (let i = 0; i < companyKeys.length; i++) {\n        const company = companyKeys[i];\n        const props = companyMap[company];\n        let totalSellCost = 0;\n        for (let j = 0; j < props.length; j++) totalSellCost += props[j].sellCost;\n        const avgPrice = Math.round(totalSellCost / props.length / 10);\n        stockConfigs.push({\n            id: 'stock_' + company,\n            name: company,\n            price: avgPrice,\n            color: companyColors[company] || '#ffffff',\n            volatility: 0.03,\n            liquidity: props.length * 0.5\n        });\n    }\n\n    stockMarket.init(stockConfigs);\n    gameProcess.stockMarket = stockMarket;\n\n    // ========== åœ°çš®-è‚¡ç¥¨è”åŠ¨ä¿®é¥°å™¨ ==========\n    gameProcess.properties.forEach(function(prop) {\n        const company = prop.company;\n        if (!company) return;\n        prop.modifierManager.add($mod__stock_rent_link);\n        prop.modifierManager.add($mod__stock_build_link);\n        prop.modifierManager.add($mod__stock_buy_link);\n        prop.modifierManager.add($mod__stock_downgrade_link);\n    });\n}) as GameEventFunction<GameContext>;"},{"id":"phase-a0gp5z","name":"å½©ç¥¨ç³»ç»Ÿåˆå§‹åŒ–","description":"å½©ç¥¨ç³»ç»Ÿåˆå§‹åŒ–","initEventCode":"(async (context, gameProcess) => {\n    class LotteryManager implements ILotteryManager {\n        stock: number[];\n        stockSize: number;\n        price: number;\n        jackpot: number;\n        currentJackpot: number;\n        playerStock: Map<string, { player: IPlayer; stock: number[]; }>;\n\n        constructor(stockNum: number, price: number, jackpot: number = 0) {\n            this.price = price;\n            this.jackpot = jackpot;\n            this.currentJackpot = jackpot;\n            this.playerStock = new Map<string, { player: IPlayer; stock: number[]; }>();\n            for (const player of gameProcess.players.values()) {\n                this.playerStock.set(player.id, { player, stock: [] })\n            }\n            this.resetStock(stockNum);\n        }\n\n        async buyLottery(player: IPlayer, lottery: number[]) {\n            const lotterySet = new Set(lottery);\n            if (lotterySet.size !== lottery.length) {\n                throw new Error(\"å½©ç¥¨å·ç é‡å¤\");\n            }\n\n            const stockSet = new Set(this.stock);\n            for (const num of lottery) {\n                if (!stockSet.has(num)) {\n                    throw new Error(`å½©ç¥¨å·ç  ${num} ä¸åœ¨åº“å­˜ä¸­`);\n                }\n            }\n\n            this.stock = this.stock.filter(s => !lotterySet.has(s));\n\n            const playerStock = this.playerStock.get(player.id);\n            if (!playerStock) {\n                throw new Error(\"ç©å®¶ä¸å­˜åœ¨\");\n            }\n            playerStock.stock.push(...lottery);\n        }\n\n        resetStock(stockSize: number): void {                                                                            // é‡ç½®åº“å­˜\n            this.stock = Array.from({ length: stockSize }, (_, index) => index + 1); this.stockSize = stockSize;\n            this.currentJackpot = this.jackpot;\n\n            // é‡ç½®æ‰€æœ‰ç©å®¶çš„å½©ç¥¨åº“å­˜\n            for (const playerStock of this.playerStock.values()) {\n                playerStock.stock = [];\n            }\n        }\n\n        draw(count: number = 1): JackpotResult {\n            // è¾¹ç•Œæ£€æŸ¥\n            if (this.stockSize === 0) {\n                return { lottery: [], jackpotPlayers: [], currentJackpot: 0 };\n            }\n\n            // 1. ç”Ÿæˆå¯ç”¨å·ç æ± ï¼ˆ1 åˆ° stockSizeï¼‰\n            const availableNumbers = Array.from(\n                { length: this.stockSize },\n                (_, i) => i + 1\n            );\n\n            // 2. éšæœºæŠ½å– count ä¸ªä¸­å¥–å·ç \n            const winningSet = new Set<number>();\n            const maxDraw = Math.min(count, this.stockSize);\n\n            while (winningSet.size < maxDraw) {\n                const randomIndex = Math.floor(Math.random() * availableNumbers.length);\n                winningSet.add(availableNumbers[randomIndex]);\n            }\n\n            const winningNumbers = Array.from(winningSet);\n\n            // 3. æ£€æŸ¥å“ªäº›ç©å®¶æœ‰è¿™äº›å·ç \n            const jackpotPlayers: { player: IPlayer; jackpot: number[]; }[] = [];\n\n            for (const { player, stock } of this.playerStock.values()) {\n                const matched = stock.filter(num => winningSet.has(num));\n                if (matched.length > 0) {\n                    jackpotPlayers.push({ player, jackpot: matched });\n                }\n            }\n\n            const res = { lottery: winningNumbers, jackpotPlayers, currentJackpot: this.currentJackpot }\n\n            if (jackpotPlayers.length > 0) {\n                this.resetStock(this.stockSize);\n            }\n\n            return res;\n        }\n    }\n    gameProcess.lotteryManager = new LotteryManager(30, 150, 4500);\n}) as GameEventFunction<GameContext>;"},{"id":"phase-3ndlon","name":"æ—¥æœŸç³»ç»Ÿåˆå§‹åŒ–","description":"æ—¥æœŸç³»ç»Ÿåˆå§‹åŒ–","initEventCode":"(async (context, gameProcess) => {\n    enum WeekDay {\n        Sunday = 0,\n        Monday = 1,\n        Tuesday = 2,\n        Wednesday = 3,\n        Thursday = 4,\n        Friday = 5,\n        Saturday = 6\n    }\n\n    class DateManager implements IDateManager {\n        currentTurn: number;\n        readonly startDay: WeekDay = WeekDay.Monday;\n\n        // é»˜è®¤æ ¼å¼æ¨¡æ¿\n        private static readonly DEFAULT_TEMPLATE = \"{day}\";\n\n        constructor() {\n            this.currentTurn = 0;\n        }\n\n        getCurrentDay(): WeekDay {\n            return this.getDayByTurn(this.currentTurn);\n        }\n\n        getCurrentDayName(): string {\n            const dayNames = [\"æ˜ŸæœŸæ—¥\", \"æ˜ŸæœŸä¸€\", \"æ˜ŸæœŸäºŒ\", \"æ˜ŸæœŸä¸‰\", \"æ˜ŸæœŸå››\", \"æ˜ŸæœŸäº”\", \"æ˜ŸæœŸå…­\"];\n            return dayNames[this.getCurrentDay()];\n        }\n\n        getDayByTurn(turn: number): WeekDay {\n            const dayOffset = turn % 7;\n            const result = (this.startDay + dayOffset) % 7;\n            return result as WeekDay;\n        }\n\n        getDayNumber(): number {\n            return this.currentTurn + 1;\n        }\n\n        getWeekNumber(): number {\n            return Math.floor(this.currentTurn / 7) + 1;\n        }\n\n        advanceTurn(count: number = 1): void {\n            if (count < 0) {\n                throw new Error(\"å›åˆæ•°ä¸èƒ½ä¸ºè´Ÿæ•°\");\n            }\n            this.currentTurn += count;\n        }\n\n        resetTurn(): void {\n            this.currentTurn = 0;\n        }\n\n        format(template: string = DateManager.DEFAULT_TEMPLATE): string {\n            return template\n                .replace(\"{day}\", this.getCurrentDayName())\n                .replace(\"{dayNum}\", this.getDayNumber().toString())\n                .replace(\"{week}\", this.getWeekNumber().toString());\n        }\n    }\n    gameProcess.dateManager = new DateManager();\n}) as GameEventFunction<GameContext>;"},{"id":"phase-xmteor","name":"æŒ‚è½½ç³»ç»Ÿå‡½æ•°","description":"æŒ‚è½½ç³»ç»Ÿå‡½æ•°","initEventCode":"(async (context, gameProcess) => {\n    gameProcess.handleBuyLottery = async function (player, lottery) {\n        if (lottery.length > 3) {\n            return;\n        }\n\n        const cost = gameProcess.lotteryManager.price * lottery.length;\n        if (player.money < cost) {\n            return;\n        }\n\n        await player.cost(cost);\n        await gameProcess.lotteryManager.buyLottery(player, lottery);\n    };\n\n    gameProcess.peekStockTrend = async function (playerId, options) {\n        const sm = gameProcess.stockMarket;\n        if (!sm || !sm.data.isOpen) return null;\n\n        function getRating(trend: number, heat: number): string {\n            const score = trend * 0.7 + heat * 0.3;\n            if (score > 0.5) return \"å¤¯çˆ†äº†\";\n            if (score > 0.3) return \"é¡¶çº§\";\n            if (score > 0.1) return \"äººä¸Šäºº\";\n            if (score > -0.2) return \"NPC\";\n            return \"æ‹‰å®Œäº†\";\n        }\n\n        const items = sm.data.stocks.map(function (stock) {\n            return {\n                id: stock.id,\n                display: {\n                    id: \"stock-peek-\" + stock.id,\n                    type: \"div\",\n                    style: { background: '#ffffff', borderRadius: '1rem' },\n                    variable: {\n                        stockName: stock.name,\n                        stockColor: stock.color,\n                        areaColor: stock.display.color,\n                        areaPath: stock.display.areaPath,\n                        linePath: stock.display.linePath,\n                        price: stock.display.price,\n                        percent: stock.display.percent,\n                    },\n                    children: [\n                        $ui__stock_preview\n                    ]\n                }\n            };\n        });\n\n        var dialogOptions: any = {\n            title: (options && options.title) || 'é€‰æ‹©è¦æŸ¥çœ‹çš„è‚¡ç¥¨',\n            itemList: items,\n            cancelText: (options && options.cancelText) || 'å–æ¶ˆ'\n        };\n        if (options && options.content) dialogOptions.content = options.content;\n        if (options && options.column) dialogOptions.column = options.column;\n\n        var result = await gameProcess.showItemSelectDialog(playerId, dialogOptions);\n        if (!result.selected.length) return null;\n\n        var stock = sm.getStock(result.selected[0]);\n        if (!stock) return null;\n\n        return {\n            stockId: stock.id,\n            stockName: stock.name,\n            price: stock.price,\n            changeRate: stock.changeRate,\n            trendValue: stock.trend,\n            heatValue: stock.heat,\n            rating: getRating(stock.trend, stock.heat)\n        };\n    };\n}) as GameEventFunction<GameContext>;"},{"id":"phase-inflation-init","name":"é€šèƒ€ç³»ç»Ÿåˆå§‹åŒ–","description":"åˆå§‹åŒ–é€šèƒ€çŠ¶æ€ï¼ˆå€ç‡1.0ï¼‰ï¼Œä¿å­˜æ¯å—åœ°çš®çš„åŸå§‹ costList åˆ° exportData.baseCostListï¼Œç”¨äºåç»­æŒ‰å€ç‡é‡ç®—","from":"ç³»ç»Ÿ","initEventCode":"(async (context, gameProcess) => {\n  gameProcess.inflationRate = 1.0;\n  gameProcess.inflationHistory = [];\n\n  gameProcess.properties.forEach(function (prop) {\n    const company = prop.company;\n    if (!company) return;\n    prop.baseCostList = [...prop.costList];\n  });\n\n  const dm = gameProcess.dateManager;\n  const cycle = gameProcess.gameSetting.inflationCycle?.value ?? 1;\n  let inflationWeek = Math.ceil(2 / cycle) * cycle;\n  const nextInflationDays = (inflationWeek - 1) * 7;\n\n  // Initialize exportData after all systems are ready\n  gameProcess.exportData = {\n    stockMarket: gameProcess.stockMarket.getExportData(),\n    date: dm.format(),\n    inflation: {\n      rate: gameProcess.inflationRate,\n      week: dm.getWeekNumber(),\n      nextInflationDays: nextInflationDays\n    }\n  };\n\n  // Broadcast to clients\n  gameProcess.gameDataBroadcast();\n}) as GameEventFunction<GameContext>;"}],"playerPreInit":[{"id":"phase-xuncvq","name":"ç©å®¶é¢„åˆå§‹åŒ–","description":"ç©å®¶é¢„åˆå§‹åŒ–é˜¶æ®µï¼ˆåœ¨ç©å®¶åˆå§‹åŒ–ä¹‹å‰è¿è¡Œï¼‰","from":"ç³»ç»Ÿ","initEventCode":"(async (context, gameProcess) => {\r\n    \r\n}) as GameEventFunction<GameContext>;\r\n"}],"propertyPreInit":[{"id":"phase-5kermw","name":"åœ°çš®é¢„åˆå§‹åŒ–","description":"åœ°çš®é¢„åˆå§‹åŒ–é˜¶æ®µï¼ˆåœ¨åœ°çš®åˆå§‹åŒ–ä¹‹å‰è¿è¡Œï¼‰","from":"ç³»ç»Ÿ","initEventCode":"(async (context, gameProcess) => {\r\n    \r\n}) as GameEventFunction<GameContext>;\r\n"}],"gameRoundStart":[{"id":"phase-mrppqo","name":"è½®æ¬¡å¼€å§‹","description":"è½®æ¬¡å¼€å§‹é˜¶æ®µ","from":"ç³»ç»Ÿ","mark":0,"initEventCode":"(async (context, gameProcess) => {\r\n    // gameProcess.players.forEach(p => {\r\n    //     p.gainCard(gameProcess.createNewChanceCard(\r\n    //         \"card-y472rl\"))\r\n    // })\r\n    // gameProcess.gameDataBroadcast();\r\n}) as GameEventFunction<GameRoundStartContext>;"},{"id":"phase-fnkiz2","name":"ç‰¹æ®Šæ—¥æœŸäº‹ä»¶","description":"ç‰¹æ®Šæ—¥æœŸäº‹ä»¶","initEventCode":"(async (ctx: GameContext, gameProcess: IGameProcess) => {\n    //å½©ç¥¨äº‹ä»¶: ç¬¬äºŒä¸ªæ˜ŸæœŸå¼€å§‹æ¯å‘¨ä¸€éƒ½ä¼šå¼€å¥–\n    if (gameProcess.dateManager.currentTurn > 6 && gameProcess.dateManager.getCurrentDay() === WeekDay.Monday) {\n        const result = gameProcess.lotteryManager.draw();\n        //æœ‰äººä¸­å¥–\n        if (result.jackpotPlayers.length > 0) {\n            // å…ˆæ˜¾ç¤ºå¼€å¥–ç»“æœ\n            await gameProcess.showMessageCard(Array.from(gameProcess.players.keys()), {\n                title: \"å¼€å¥–å•¦\",\n                content: {\n                    id: \"lottery-result-container\",\n                    type: \"div\",\n                    style: {\n                        display: \"flex\",\n                        flexDirection: \"column\",\n                        gap: \"0.75rem\",\n                        maxWidth: \"25rem\"\n                    },\n                    children: [\n                        {\n                            id: \"lottery-numbers\",\n                            type: \"text\",\n                            content: `å¼€å¥–å·ç : ${result.lottery.join('ã€')}`,\n                            style: {\n                                fontSize: \"1.125rem\",\n                                fontWeight: \"bold\",\n                                color: \"#333333\"\n                            }\n                        },\n                        {\n                            id: \"winning-player-container\",\n                            type: \"div\",\n                            style: {\n                                fontSize: \"0.875rem\",\n                            },\n                            children: result.jackpotPlayers.map((jackpot, index) => ({\n                                id: `winning-player-${index}`,\n                                type: 'text',\n                                content: jackpot.player.name,\n                                style: {\n                                    color: jackpot.player.getUser().color\n                                }\n                            }))\n                        },\n                        {\n                            id: \"prize-amount\",\n                            type: \"text\",\n                            content: `ä¸­å¥–å¥–é‡‘: Â¥${result.currentJackpot}`,\n                            style: {\n                                fontSize: \"1rem\",\n                                fontWeight: \"600\",\n                                color: \"#ff5722\"\n                            }\n                        }\n                    ]\n                },\n                duration: 4000,\n            })\n            // ç­‰å¾…UIæ˜¾ç¤ºåå†å‘æ”¾å¥–é‡‘\n            const totalWinningNumbers = result.jackpotPlayers.reduce((sum, p) => sum + p.jackpot.length, 0);\n            for (const jackpotPlayer of result.jackpotPlayers) {\n                const share = Math.round(result.currentJackpot * (jackpotPlayer.jackpot.length / totalWinningNumbers));\n                if (share > 0) {\n                    await jackpotPlayer.player.gain(share, \"system\");\n                }\n            }\n        } else {\n            //æ²¡äººä¸­å¥–\n            await gameProcess.showMessageCard(Array.from(gameProcess.players.keys()), {\n                title: \"å¼€å¥–å•¦\",\n                content: {\n                    id: \"lottery-result-container\",\n                    type: \"div\",\n                    style: {\n                        display: \"flex\",\n                        flexDirection: \"column\",\n                        gap: \"0.75rem\",\n                        maxWidth: \"25rem\"\n                    },\n                    children: [\n                        {\n                            id: \"lottery-numbers\",\n                            type: \"text\",\n                            content: `å¼€å¥–å·ç : ${result.lottery.join('ã€')}`,\n                            style: {\n                                fontSize: \"1.125rem\",\n                                fontWeight: \"bold\",\n                                color: \"#333333\"\n                            }\n                        },\n                        {\n                            id: \"winning-player\",\n                            type: \"text\",\n                            content: `æ²¡æœ‰äººä¸­å¥–`,\n                            style: {\n                                fontSize: \"0.875rem\",\n                                color: \"#666666\"\n                            }\n                        },\n                        {\n                            id: \"prize-amount\",\n                            type: \"text\",\n                            content: `å½“å‰å¥–æ± : Â¥${result.currentJackpot}`,\n                            style: {\n                                fontSize: \"1rem\",\n                                fontWeight: \"600\",\n                                color: \"#ff5722\"\n                            }\n                        }\n                    ]\n                },\n                duration: 4000,\n            })\n        }\n\n    }\n})"},{"id":"phase-inflation-weekly","name":"é€šèƒ€ç‡å‘¨è°ƒæ•´","description":"æ¯å‘¨ä¸€ï¼ˆç¬¬2å‘¨èµ·ï¼‰æ£€æµ‹äººå‡ç°é‡‘ï¼Œæ ¹æ®ç°é‡‘æ°´å¹³è°ƒæ•´é€šèƒ€æ­¥é•¿ï¼ˆ5%~25%ï¼‰ï¼Œç›´æ¥ä¿®æ”¹æ‰€æœ‰åœ°çš® costList = baseCostList Ã— rateï¼Œé€šçŸ¥ç©å®¶","from":"ç³»ç»Ÿ","initEventCode":"(async (context, gameProcess) => {\n    const dm = gameProcess.dateManager;\n    if (dm.currentTurn <= 6) return;\n    if (dm.getCurrentDay() !== WeekDay.Monday) return;\n\n    const cycle = gameProcess.gameSetting.inflationCycle?.value ?? 1;\n    if (dm.getWeekNumber() % cycle !== 0) return;\n\n    const week = dm.getWeekNumber();\n\n    let totalCash = 0;\n    let activePlayers = 0;\n    gameProcess.players.forEach(function(p) {\n        totalCash += p.money;\n        activePlayers++;\n    });\n    if (activePlayers === 0) return;\n    const avgCash = Math.round(totalCash / activePlayers);\n\n    let step: number;\n    if (avgCash < 2000) {\n        step = 0.05;\n    } else if (avgCash < 5000) {\n        step = 0.10;\n    } else if (avgCash < 10000) {\n        step = 0.15;\n    } else {\n        step = 0.25;\n    }\n\n    step *= (1 + (Math.random() - 0.5) * 0.06);\n\n    const oldRate = gameProcess.inflationRate;\n    const newRate = Math.round((oldRate + step) * 100) / 100;\n    gameProcess.inflationRate = newRate;\n\n    gameProcess.properties.forEach(function(prop) {\n        const company = prop.company;\n        if (!company) return;\n        const base = prop.baseCostList;\n        if (!base) return;\n        prop.costList = base.map(function(v) { return Math.max(1, Math.round(v * newRate)); });\n    });\n\n    const pctChange = ((newRate - oldRate) * 100).toFixed(1);\n\n    await gameProcess.showMessageCard(Array.from(gameProcess.players.keys()), {\n        title: 'å¸‚åœºå…¬æŠ¥',\n        content: {\n            id: 'inflation-report',\n            type: 'div',\n            style: {\n                display: 'flex',\n                flexDirection: 'column',\n                gap: '0.5rem',\n                maxWidth: '22rem',\n                padding: '0.5rem'\n            },\n            children: [\n                {\n                    id: 'inflation-title',\n                    type: 'text',\n                    content: 'ç‰©ä»·ä¸Šæ¶¨',\n                    style: {\n                        fontSize: '1.25rem',\n                        fontWeight: 'bold',\n                        color: '#ef4444'\n                    }\n                },\n                {\n                    id: 'inflation-rate',\n                    type: 'text',\n                    content: 'è¿‡è·¯è´¹å€ç‡: ' + oldRate.toFixed(2) + 'x â†’ ' + newRate.toFixed(2) + 'x (+' + pctChange + '%)',\n                    style: {\n                        fontSize: '1rem',\n                        color: '#333333'\n                    }\n                },\n                {\n                    id: 'inflation-cash',\n                    type: 'text',\n                    content: 'äººå‡èµ„é‡‘: Â¥' + avgCash,\n                    style: {\n                        fontSize: '0.875rem',\n                        color: '#666666'\n                    }\n                },\n                {\n                    id: 'inflation-week',\n                    type: 'text',\n                    content: 'ç¬¬' + week + 'å‘¨',\n                    style: {\n                        fontSize: '0.8rem',\n                        color: '#999999'\n                    }\n                }\n            ]\n        },\n        duration: 4000\n    });\n\n    gameProcess.inflationHistory.push({ week: week, rate: newRate, avg: avgCash });\n    gameProcess.gameDataBroadcast();\n}) as GameEventFunction<GameRoundStartContext>;"}],"playerRound":[{"id":"phase-k54cn2","name":"ç©å®¶å›åˆå¼€å§‹","description":"ç©å®¶å›åˆå¼€å§‹é˜¶æ®µ","from":"ç³»ç»Ÿ","mark":1,"initEventCode":"(async (context, gameProcess) => {\r\n    \r\n}) as GameEventFunction<PlayerRoundStartContext>;"},{"id":"phase-g01fxb","name":"ç©å®¶æ“ä½œ","description":"ç©å®¶æ“ä½œé˜¶æ®µ","from":"ç³»ç»Ÿ","mark":2,"initEventCode":"(async (ctx, gameProcess) => {\n    const currentPlayer = ctx.currentRoundPlayer;\n    const currentPlayerId = currentPlayer.id;\n\n    // ä½¿ç”¨å¾ªç¯æ¥å¤„ç†å¯èƒ½çš„å¤šæ¬¡æ“ä½œï¼Œç›´åˆ°ç©å®¶æ·éª°å­æˆ–è¶…æ—¶\n    while (true) {\n        gameProcess.setCurrentEventName(`ç­‰å¾…${currentPlayer.name}æ“ä½œ`);\n\n        // åŒæ—¶ç›‘å¬æ·éª°å­ï¼ˆå¸¦è¶…æ—¶ï¼‰å’Œä½¿ç”¨æœºä¼šå¡\n        const operation = await Promise.race([\n            gameProcess.oncePlayerOperationAsync(currentPlayerId, OperateType.RollDice)\n                .then(res => ({ type: OperateType.RollDice, res })),\n            gameProcess.oncePlayerOperationAsync(currentPlayerId, OperateType.UseChanceCard)\n                .then(res => ({ type: OperateType.UseChanceCard, res }))\n        ]);\n\n        gameProcess.removePlayerAllOperationListener(currentPlayerId, OperateType.RollDice);\n        gameProcess.removePlayerAllOperationListener(currentPlayerId, OperateType.UseChanceCard);\n\n        if (operation.type === OperateType.RollDice) {\n            break;\n        } else if (operation.type === OperateType.UseChanceCard) {\n            if (operation.res) {\n                const { chanceCardId, targetIdList } = operation.res;\n                await gameProcess.handleUseChanceCard(currentPlayer, chanceCardId, targetIdList);\n            }\n        }\n    }\n\n    // å°†éª°å­ç»“æœå†™å…¥ä¸Šä¸‹æ–‡ï¼Œå¹¶å­˜å‚¨åˆ°ç©å®¶å¯¹è±¡ä¸­ä¾›å…¶ä»–æœºåˆ¶ä½¿ç”¨\n    const diceResult = await currentPlayer.rollDices();\n    ctx.diceResult = diceResult;\n    currentPlayer.lastDiceRollResults = diceResult;\n}) as GameEventFunction<RollDiceContext>"},{"id":"phase-q3ztq7","name":"ç©å®¶ç§»åŠ¨","description":"ç©å®¶ç§»åŠ¨é˜¶æ®µ","from":"ç³»ç»Ÿ","mark":3,"initEventCode":"(async (context, gameProcess) => {\r\n\t//ç©å®¶ç§»åŠ¨\r\n\tconst player = context.currentRoundPlayer;\r\n    player.lastPositionId = player.positionMapItemId;\r\n\tawait player.walk(context.diceResult.map(d => d.result).reduce((p, c) => p + c, 0));\r\n\tcontext.targetIndex = player.positionIndex;\r\n}) as GameEventFunction<PlayerMoveContext>;"},{"id":"phase-aku4r0","name":"åˆ°è¾¾äº‹ä»¶","description":"åˆ°è¾¾äº‹ä»¶é˜¶æ®µ","from":"ç³»ç»Ÿ","mark":4,"initEventCode":"(async (context, gameProcess) => {\r\n\tconst player = context.currentRoundPlayer;\r\n\tawait gameProcess.handleArriveEvent(player);\r\n}) as GameEventFunction<ArrivedEventContext>;"},{"id":"phase-462sxl","name":"ç©å®¶å›åˆç»“æŸ","description":"ç©å®¶å›åˆç»“æŸé˜¶æ®µ","from":"ç³»ç»Ÿ","mark":5,"initEventCode":"(async (context, gameProcess) => {\r\n}) as GameEventFunction<PlayerRoundEndContext>;"}],"gameRoundEnd":[{"id":"phase-fji36p","name":"è½®æ¬¡ç»“æŸ","description":"è½®æ¬¡ç»“æŸé˜¶æ®µ","from":"ç³»ç»Ÿ","mark":6,"initEventCode":"(async (context, gameProcess) => {\n    gameProcess.currentRound += 1;\n\n    gameProcess.dateManager.advanceTurn(1);\n\n    const stockMarket = gameProcess.stockMarket;\n\n    stockMarket.tick();\n\n    stockMarket.data.stocks.forEach(stock => {\n        const intensity = 1 + (gameProcess.currentRound * 0.1);\n        stockMarket.triggerEvent(stock.id, 'RANDOM', intensity);\n    });\n\n    const dm = gameProcess.dateManager;\n    const cycle = gameProcess.gameSetting.inflationCycle?.value ?? 1;\n    let nextInflationDays: number;\n    const currentWeek = dm.getWeekNumber();\n    const isMonday = dm.currentTurn % 7 === 0;\n    if (dm.currentTurn > 6 && isMonday && currentWeek % cycle === 0) {\n        nextInflationDays = 0;\n    } else {\n        let nextMondayTurn = isMonday ? dm.currentTurn + 7 : Math.ceil((dm.currentTurn + 1) / 7) * 7;\n        if (nextMondayTurn < 7) nextMondayTurn = 7;\n        let nextMondayWeek = Math.floor(nextMondayTurn / 7) + 1;\n        let inflationWeek = Math.ceil(nextMondayWeek / cycle) * cycle;\n        if (inflationWeek < 2) inflationWeek = Math.ceil(2 / cycle) * cycle;\n        nextInflationDays = (inflationWeek - 1) * 7 - dm.currentTurn;\n    }\n\n    gameProcess.exportData = {\n        stockMarket: stockMarket.getExportData(),\n        date: dm.format(),\n        inflation: {\n            rate: gameProcess.inflationRate,\n            week: currentWeek,\n            nextInflationDays: nextInflationDays\n        }\n    };\n\n    gameProcess.gameDataBroadcast();\n\n    gameProcess.customData.stockMarketData = stockMarket.data;\n    gameProcess.customData.lotteryData = {\n        stock: gameProcess.lotteryManager.stock,\n        currentJackpot: gameProcess.lotteryManager.currentJackpot,\n        playerStock: {}\n    };\n    gameProcess.lotteryManager.playerStock.forEach((value, key) => {\n        gameProcess.customData.lotteryData.playerStock[key] = value.stock;\n    });\n    gameProcess.customData.dateData = {\n        currentTurn: dm.currentTurn\n    };\n    gameProcess.customData.inflationData = {\n        rate: gameProcess.inflationRate,\n        history: [...gameProcess.inflationHistory]\n    };\n})"}],"postRestore":[{"id":"phase-9k4e5y","name":"å­˜æ¡£æ¢å¤å","description":"å­˜æ¡£æ¢å¤åé˜¶æ®µï¼ˆåœ¨ restoreFromSnapshot ä¹‹åã€GameInit å¹¿æ’­ä¹‹å‰è¿è¡Œï¼Œä»…åœ¨æœ‰å­˜æ¡£æ•°æ®æ—¶æ‰§è¡Œä¸€æ¬¡ï¼‰","from":"ç³»ç»Ÿ","initEventCode":"(async (context, gameProcess) => {\n    const sm = gameProcess.stockMarket;\n    const lm = gameProcess.lotteryManager;\n    const dm = gameProcess.dateManager;\n\n    if (gameProcess.customData.stockMarketData) {\n        const saved = gameProcess.customData.stockMarketData;\n        sm.data.isOpen = saved.isOpen;\n        sm.data.stocks = saved.stocks;\n        sm.data.portfolios = saved.portfolios;\n        sm.data.marketTrend = saved.marketTrend;\n        sm.data.volatilityMultiplier = saved.volatilityMultiplier;\n        sm.data.tick = saved.tick;\n    }\n\n    if (gameProcess.customData.lotteryData) {\n        const saved = gameProcess.customData.lotteryData;\n        lm.stock = saved.stock;\n        lm.currentJackpot = saved.currentJackpot;\n        for (const playerId in saved.playerStock) {\n            const playerStock = lm.playerStock.get(playerId);\n            if (playerStock) {\n                playerStock.stock = saved.playerStock[playerId];\n            }\n        }\n    }\n\n    if (gameProcess.customData.dateData) {\n        dm.currentTurn = gameProcess.customData.dateData.currentTurn;\n    }\n\n    const savedInflation = gameProcess.customData.inflationData;\n    const restoredRate = savedInflation?.rate ?? gameProcess.exportData?.inflation?.rate ?? 1;\n    gameProcess.inflationRate = restoredRate;\n    gameProcess.inflationHistory = Array.isArray(savedInflation?.history) ? savedInflation.history : [];\n\n    gameProcess.properties.forEach(function(prop) {\n        const company = prop.company;\n        if (!company) return;\n        const base = prop.baseCostList;\n        if (!base) return;\n        prop.costList = base.map(function(v) { return Math.max(1, Math.round(v * restoredRate)); });\n    });\n}) as GameEventFunction<GameContext>;"}]},"buildingModelIdList":["model-3c7a8fbb-eccc-405e-8c3e-f11909aebae9","model-61dab177-1a23-45f7-be12-3af7b9336ae5","model-cf31d466-ede0-4455-8f0d-fd83564edc21"],"uiTemplates":[{"id":"tmpl-inpqnc","name":"æˆ‘çš„è‚¡ç¥¨æŒä»“","slug":"stock_portfolio","template":{"id":"stock-portfolio-root","type":"div","style":{"padding":"0.625rem 0.8rem","height":"100%"},"children":[{"id":"header","type":"div","style":{"display":"flex","justifyContent":"center","alignItems":"center","padding":"0.25rem 0.375rem","marginBottom":"0.5rem"},"children":[{"id":"title","type":"text","content":"æˆ‘çš„è‚¡ç¥¨æŒä»“","style":{"fontSize":"1rem","fontWeight":"800","letterSpacing":"1px","color":"var(--fp-color-text-secondary)"}}]},{"id":"empty-state","type":"div","style":{"display":"flex","justifyContent":"center","alignItems":"center","padding":"2rem","color":"var(--fp-color-text-secondary)"},"children":[{"id":"empty-text","type":"text","content":"æš‚æ— æŒä»“"}],"vShow":"!hasHolding"},{"id":"stock-list","type":"div","style":{"overflowY":"scroll","display":"flex","flexDirection":"column","gap":"1rem","padding":"0.5rem 1rem","flex":"1","max-height":"20rem","width":"40rem","flex-wrap":"wrap"},"vFor":"","children":[{"id":"stock-card","type":"div","style":{"display":"flex","flexDirection":"column","gap":"0.375rem","borderRadius":"0.375rem","padding":"1rem","background-color":"#ffffff","box-shadow":"var(--fp-shadow-card)"},"props":{"class":"felt-card-no-stitched"},"children":[{"id":"stock-info-row","type":"div","style":{"display":"flex","alignItems":"center","gap":"0.5rem"},"children":[{"id":"stoc