;\n    price: number;\n    amount: number;\n    totalCost: number;\n}\n\ninterface StockMarketData {\n    isOpen: boolean;\n    stocks: Stock[];\n    portfolios: Record<string, Record<string, number>>;\n    marketTrend: number;\n    volatilityMultiplier: number;\n    tick: number;\n}\n\ninterface IStockMarketManager {\n    readonly data: StockMarketData;\n    getExportData(): StockMarketData;\n    init(configs: StockConfig[]): void;\n    addStock(config: StockConfig): Stock | null;\n    getTaxRate(isBuy: boolean): number;\n    getStock(stockId: string): Stock | undefined;\n    getHolding(playerId: string, stockId: string): number;\n    getPlayerHoldingStock(playerId: string): { stock: Stock, holding: number }[];\n    getTransactionCost(stockId: string, amount: number): number;\n    canTrade(playerId: string, stockId: string, amount: number, isBuy: boolean): TradeCheckResult;\n    commitBuy(playerId: string, stockId: string, amount: number): TradeReceipt | null;\n    commitSell(playerId: string, stockId: string, amount: number): TradeReceipt | null;\n    triggerEvent(stockId: string, type: 'RENT' | 'BUILD' | 'RANDOM', intensity?: number): void;\n    tick(): void;\n    setMarketTrend(value: number): void;\n}\n\n// ========================\n// å½©ç¥¨ç³»ç»Ÿ\n// ========================\n\ninterface ILotteryManager {\n    stock: number[];\n    playerStock: Map<string, { player: IPlayer, stock: number[] }>\n    price: number;\n    jackpot: number;\n    currentJackpot: number;\n    resetStock(stockSize: number): void;\n    buyLottery(player: IPlayer, lottery: number[]): Promise<void>;\n    draw(): JackpotResult;\n}\n\ninterface JackpotResult {\n    lottery: number[];\n    jackpotPlayers: { player: IPlayer; jackpot: number[]; }[];\n    currentJackpot: number;\n}\n\n// ========================\n// æ—¥æœŸç³»ç»Ÿ\n// ========================\n\nenum WeekDay {\n    Sunday = 0,\n    Monday = 1,\n    Tuesday = 2,\n    Wednesday = 3,\n    Thursday = 4,\n    Friday = 5,\n    Saturda