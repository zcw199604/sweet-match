content: `<b>${target.name}</b> çš„<color:red><b>éª°å­å°å°</b></color> ç»“æŸäº†`,\n            duration: 2000\n        });\n    });\n    gameProcess.gameDataBroadcast()\n    await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n        title: 'éª°å­å°å°',\n        content: `<b>${target.name}</b> è¢«æ–½åŠ äº†<color:red><b>éª°å­å°å°</b></color>ï¼åªèƒ½æ·1é¢—éª°å­ï¼ŒæŒç»­3å›åˆ`,\n        duration: 2000\n    });\n})"},{"id":"card-6yly84","name":"é¥æ§å™¨","color":"#ea3e3e","description":"å¯ä»¥è®©ç›®æ ‡å‘å‰èµ°1-6æ­¥ï¼Œå¹¶è§¦å‘ç›¸åº”äº‹ä»¶","type":"ToPlayer","iconId":"image-h61pvw","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    const res = await gameProcess.showItemSelectDialog(sourcePlayer.id, {\n        title: \"é€‰æ‹©æ­¥æ•°\",\n        content: \"è®©ç›®æ ‡å‘å‰èµ°æŒ‡å®šæ­¥æ•°\",\n        itemList: [1, 2, 3, 4, 5, 6].map((n => ({ id: `${n}`, display: `${n}æ­¥` })))\n    })\n    await target.walk(Number(res.selected[0]));\n    await gameProcess.handleArriveEvent(target);\n});"},{"id":"card-7bz7m0","name":"ä¸€åœºè±ªèµŒ","color":"#2941a3","description":"èŠ±è´¹ï¿¥2000è½¬åŠ¨å‘½è¿è½®ç›˜ï¼Œéšæœºè§¦å‘ä¸€ç§æ•ˆæœ","type":"ToSelf","iconId":"image-ipf5ch","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    const betAmount = 2000;\n    const allPlayerIds = gameProcess.getAllPlayersId();\n\n    if (sourcePlayer.money < betAmount) {\n        throw Error(\"èµ„é‡‘ä¸è¶³ï¼Œè‡³å°‘éœ€è¦ ï¿¥\" + betAmount + \" æ‰èƒ½å‚ä¸èµŒå±€\");\n    }\n\n    await sourcePlayer.cost(betAmount, MoneyTag.CARD);\n    gameProcess.msgNotifyBroadcast(\"info\", sourcePlayer.name + \" èŠ±äº† ï¿¥\" + betAmount + \" è½¬åŠ¨å‘½è¿è½®ç›˜...\");\n\n    const events = [\n        // 1. è´¢ç¥é©¾åˆ° â€” è·å¾—ï¿¥5000\n        async () => {\n            await sourcePlayer.gain(5000, MoneyTag.CARD);\n            await gameProcess.showMessageCard(allPlayerIds, {\n                title: \"è´¢ç¥é©¾åˆ°\",\n                content: `<b><color:primary>${sourcePlayer.name}</color></b> èµŒæ³¨ç¿»äº†2.5å€ï¼\\n<color:green>ï¿¥${betAmount}</color> â†’ <b><color:green>ï¿¥5000</color></b>`,\n                duration: 3000\n            });\n        },\n        // 2. åŸºå»ºç‹‚é­” â€” éšæœºä¸€å¤„å·±æ–¹åœ°äº§å…è´¹å‡çº§\n        async () => {\n            const upgradable = sourcePlayer.properties.filter(p => p.level < p.maxLevel);\n            if (upgradable.length === 0) {\n                await gameProcess.showMessageCard(allPlayerIds, {\n                    title: \"åŸºå»ºç‹‚é­”\",\n                    content: `<b><color:primary>${sourcePlayer.name}</color></b> æƒ³æåŸºå»ºï¼Œä½†æ²¡æœ‰å¯å‡çº§çš„åœ°äº§`,\n                    duration: 3000\n                });\n                return;\n            }\n            const prop = upgradable[Math.floor(Math.random() * upgradable.length)];\n            const oldLevel = prop.level;\n            await prop.levelUp();\n            await gameProcess.showMessageCard(allPlayerIds, {\n                title: \"åŸºå»ºç‹‚é­”\",\n                content: `<b><color:primary>${sourcePlayer.name}</color></b> è·å¾—å…è´¹å‡çº§ï¼\\n<b>${prop.name}</b> ${oldLevel}çº§ â†’ <b>${prop.level}çº§</b>`,\n                duration: 3000\n            });\n        },\n        // 3. è‚¡å¸‚èµ ç¤¼ â€” è·å¾—20è‚¡éšæœºè‚¡ç¥¨\n        async () => {\n            const sm = gameProcess.stockMarket;\n            if (!sm || !sm.data.isOpen || sm.data.stocks.length === 0) {\n                await gameProcess.showMessageCard(allPlayerIds, {\n                    title: \"è‚¡å¸‚èµ ç¤¼\",\n                    content: `<b><color:primary>${sourcePlayer.name}</color></b> æƒ³ç‚’è‚¡ï¼Œä½†è‚¡å¸‚ä¼‘å¸‚ä¸­`,\n                    duration: 3000\n                });\n                return;\n            }\n            const stock = sm.data.stocks[Math.floor(Math.random() * sm.data.stocks.length)];\n            const receipt = sm.commitBuy(sourcePlayer.id, stock.id, 20);\n            if (!receipt) {\n                await gameProcess.showMessageCard(allPlayerIds, {\n                    title: \"è‚¡å¸‚èµ ç¤¼\",\n                    content: `<b><color:primary>${sourcePlayer.name}</color></b> äº¤æ˜“å¤±è´¥ï¼Œæ— æ³•é¢†å–èµ è‚¡`,\n                    duration: 3000\n                });\n                return;\n            }\n            await gameProcess.showMessageCard(allPlayerIds, {\n                title: \"è‚¡å¸‚èµ ç¤¼\",\n                content: `<b><color:primary>${sourcePlayer.name}</color></b> è·å¾— <b>${stock.name}</b> èµ è‚¡ Ã—20ï¼\\nå½“å‰è‚¡ä»·ï¼šï¿¥${stock.price.toFixed(1)}`,\n                duration: 3000\n            });\n        },\n        // 4. å½©ç¥¨è¾¾äºº â€” 3å¼ å…è´¹å½©ç¥¨\n        async () => {\n            const lm = gameProcess.lotteryManager;\n            if (lm.stock.length === 0) {\n                await gameProcess.showMessageCard(allPlayerIds, {\n                    title: \"å½©ç¥¨è¾¾äºº\",\n                    content: `<b><color:primary>${sourcePlayer.name}</color></b> æƒ³ä¹°å½©ç¥¨ï¼Œä½†å·²å”®ç½„`,\n                    duration: 3000\n                });\n                return;\n            }\n            const count = Math.min(3, lm.stock.length);\n            const picked: number[] = [];\n            const stockCopy = [...lm.stock];\n            for (let i = 0; i < count; i++) {\n                const idx = Math.floor(Math.random() * stockCopy.length);\n                picked.push(stockCopy[idx]);\n                stockCopy.splice(idx, 1);\n            }\n            await lm.buyLottery(sourcePlayer, picked);\n            await gameProcess.showMessageCard(allPlayerIds, {\n                title: \"å½©ç¥¨è¾¾äºº\",\n                content: `<b><color:primary>${sourcePlayer.name}</color></b> å…è´¹è·å¾— <b>${count}</b> å¼ å½©ç¥¨ï¼\\n<color:primary>${picked.join(\"ã€\")}</color>`,\n                duration: 3000\n            });\n        },\n        // 5. é¡ºæ‰‹ç‰µç¾Š â€” å·å–å¯¹æ‰‹ä¸€å¼ æœºä¼šå¡\n        async () => {\n            const opponents = Array.from(gameProcess.players.values()).filter(\n                p => p.id !== sourcePlayer.id && !p.isBankrupted && p.chanceCards.length > 0\n            );\n            if (opponents.length === 0) {\n                await gameProcess.showMessageCard(allPlayerIds, {\n                    title: \"é¡ºæ‰‹ç‰µç¾Š\",\n                    content: `<b><color:primary>${sourcePlayer.name}</color></b> æƒ³å·å¡ï¼Œä½†æ²¡äººæœ‰å¡å¯å·`,\n                    duration: 3000\n                });\n                return;\n            }\n            const victim = opponents[Math.floor(Math.random() * opponents.length)];\n            const stolenCard = victim.chanceCards[Math.floor(Math.random() * victim.chanceCards.length)];\n            const newCard = gameProcess.createNewChanceCard(stolenCard.getSourceId());\n            await victim.loseCard(stolenCard.getId());\n            await sourcePlayer.gainCard(newCard);\n            await gameProcess.showMessageCard(allPlayerIds, {\n                title: \"é¡ºæ‰‹ç‰µç¾Š\",\n                content: `<b><color:primary>${sourcePlayer.name}</color></b> ä» <b>${victim.name}</b> å¤„å·èµ°äº†ä¸€å¼ æœºä¼šå¡ï¼\\n<color:primary>${stolenCard.getName()}</color>`,\n                duration: 3000\n            });\n        },\n        // 6. å‘½è¿é¦ˆèµ  â€” 2å¼ éšæœºæœºä¼šå¡\n        async () => {\n            const allTemplates = Array.from(gameProcess.chanceCardInfos.values());\n            if (allTemplates.length === 0) {\n                await gameProcess.showMessageCard(allPlayerIds, {\n                    title: \"å‘½è¿é¦ˆèµ \",\n                    content: `<b><color:primary>${sourcePlayer.name}</color></b> æƒ³è¦æœºä¼šå¡ï¼Œä½†å¡æ± ä¸ºç©º`,\n                    duration: 3000\n                });\n                return;\n            }\n            const count = Math.min(2, 4 - sourcePlayer.chanceCards.length);\n            if (count <= 0) {\n                await gameProcess.showMessageCard(allPlayerIds, {\n                    title: \"å‘½è¿é¦ˆèµ \",\n                    content: `<b><color:primary>${sourcePlayer.name}</color></b> æ‰‹ç‰Œå·²æ»¡ï¼Œæ— æ³•è·å¾—æ›´å¤š`,\n                    duration: 3000\n                });\n                return;\n            }\n            const names: string[] = [];\n            for (let i = 0; i < count; i++) {\n                const tpl = allTemplates[Math.floor(Math.random() * allTemplates.length)];\n                const card = gameProcess.createNewChanceCard(tpl.id);\n                await sourcePlayer.gainCard(card);\n                names.push(tpl.name);\n            }\n            await gameProcess.showMessageCard(allPlayerIds, {\n                title: \"å‘½è¿é¦ˆèµ \",\n                content: `<b><color:primary>${sourcePlayer.name}</color></b> å°†èµŒæ³¨æ¢æˆäº† <b>${count}</b> å¼ æœºä¼šå¡ï¼\\n<color:primary>${names.join(\"ã€\")}</color>`,\n                duration: 3000\n            });\n        },\n        // 7. è¡€æœ¬æ— å½’ â€” å•¥ä¹Ÿæ²¡æœ‰\n        async () => {\n            await gameProcess.showMessageCard(allPlayerIds, {\n                title: \"è¡€æœ¬æ— å½’\",\n                content: `<b><color:primary>${sourcePlayer.name}</color></b> çš„ ï¿¥${betAmount} æ‰“äº†æ°´æ¼‚...\\nå‘½è¿ä»€ä¹ˆä¹Ÿæ²¡ç»™`,\n                duration: 3000\n            });\n        },\n        // 8. æ‹†è¿é€šçŸ¥ â€” æ‰€æœ‰å»ºç­‘é™1çº§\n        async () => {\n            const leveled = sourcePlayer.properties.filter(p => p.level > 0);\n            if (leveled.length === 0) {\n                await gameProcess.showMessageCard(allPlayerIds, {\n                    title: \"æ‹†è¿é€šçŸ¥\",\n                    content: `<b><color:primary>${sourcePlayer.name}</color></b> æ”¶åˆ°æ‹†è¿é€šçŸ¥ï¼Œä½†æ²¡æœ‰å»ºç­‘å¯æ‹†`,\n                    duration: 3000\n                });\n                return;\n            }\n            for (const prop of leveled) {\n                await prop.levelDown();\n            }\n            await gameProcess.showMessageCard(allPlayerIds, {\n                title: \"æ‹†è¿é€šçŸ¥\",\n                content: `<b><color:primary>${sourcePlayer.name}</color></b> æ”¶åˆ°æ‹†è¿é€šçŸ¥ï¼\\n${leveled.map(p => p.name).join(\"ã€\")} å…¨éƒ¨é™äº†1çº§`,\n                duration: 3000\n            });\n        }\n    ];\n\n    await events[Math.floor(Math.random() * events.length)]();\n})"},{"id":"card-7epkfv","name":"ä¸åŠ¨äº§ç¨","type":"ToPlayer","description":"ç›®æ ‡ç©å®¶æŒ‰æŒæœ‰åœ°äº§æ•°é‡ç¼´ç¨ï¼Œæ¯å¤„åœ°äº§ç¼´çº³\\n( 300 Ã— å½“å‰é€šèƒ€å€ç‡ )ï¿¥","color":"#8B0000","iconId":"image-vzskja","effectCode":"(async ( sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n  if (target.properties.length === 0) {\n    throw new Error(\"ç›®æ ‡ç©å®¶æ²¡æœ‰æŒæœ‰åœ°äº§\");\n  }\n  const taxPerProperty = Math.round(300 * gameProcess.inflationRate);\n  const count = target.properties.length;\n  const tax = count * taxPerProperty;\n  await target.cost(tax);\n  await sourcePlayer.gain(tax, MoneyTag.CARD);\n  gameProcess.msgNotifyBroadcast(\"warning\", `${target.name} å› æŒæœ‰${count}å¤„åœ°äº§ï¼Œè¢«å¼ºåˆ¶å¾æ”¶ ï¿¥${tax} ä¸åŠ¨äº§ç¨ï¼å½“å‰ä½™é¢ ï¿¥${target.money}`);\n  await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n    title: \"ä¸åŠ¨äº§ç¨\",\n    content: `<b>${sourcePlayer.name}</b> å¯¹ <b>${target.name}</b> å¾æ”¶ä¸åŠ¨äº§ç¨ï¼ï¼ˆï¿¥${taxPerProperty}/å¤„ Ã— ${gameProcess.inflationRate.toFixed(2)}å€é€šèƒ€ï¼‰<br><br>${count}å¤„åœ°äº§ï¼Œå¼ºåˆ¶å¾æ”¶ ï¿¥${tax}<br>${target.name} å½“å‰ä½™é¢ï¼š<color:red>ï¿¥${target.money}</color>`,\n    duration: 4000\n  });\n})"},{"id":"card-9wrxjv","name":"ç»“ç›Ÿ","color":"#47c256","description":"é€‰æ‹©ä¸€ä½ç©å®¶ç»“ç›Ÿï¼Œå„è‡ªå…é™¤å¯¹æ–¹3æ¬¡çš„è¿‡è·¯è´¹","type":"ToOtherPlayer","iconId":"image-ixz4g4","effectCode":"(async ( sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n  const targetPlayer = target as IPlayer;\n\n  function cleanupAlliance(player: IPlayer) {\n    player.modifierManager.removeByTag('alliance');\n    delete player.allianceWith;\n  }\n\n  const oldSourceAllyId = sourcePlayer.allianceWith?.allyId;\n  if (oldSourceAllyId) {\n    const oldSourceAlly = gameProcess.players.get(oldSourceAllyId);\n    if (oldSourceAlly) {\n      cleanupAlliance(oldSourceAlly);\n    }\n  }\n\n  const oldTargetAllyId = targetPlayer.allianceWith?.allyId;\n  if (oldTargetAllyId) {\n    const oldTargetAlly = gameProcess.players.get(oldTargetAllyId);\n    if (oldTargetAlly) {\n      cleanupAlliance(oldTargetAlly);\n    }\n  }\n\n  cleanupAlliance(sourcePlayer);\n  cleanupAlliance(targetPlayer);\n\n  sourcePlayer.allianceWith = { allyId: targetPlayer.id, remainingTimes: 3 };\n  targetPlayer.allianceWith = { allyId: sourcePlayer.id, remainingTimes: 3 };\n\n  sourcePlayer.modifierManager.add($mod__alliance_toll_free_player);\n  targetPlayer.modifierManager.add($mod__alliance_toll_free_player);\n\n  gameProcess.msgNotifyBroadcast('info', `${sourcePlayer.name} å’Œ ${targetPlayer.name} ç»“æˆè”ç›Ÿï¼å„è‡ªå…é™¤å¯¹æ–¹ 3 æ¬¡è¿‡è·¯è´¹ï¼`);\n});"},{"id":"card-a06g8w","name":"æ‹†è¿ä»¤","type":"ToProperty","description":"é€‰æ‹©ä¸€å—åœ°äº§æ‹†é™¤ä¸€å±‚å»ºç­‘ï¼Œä¸šä¸»è·å¾—ä¸€åŠå»ºé€ è´¹çš„è¡¥å¿","color":"#8B4513","iconId":"image-9ogdah","effectCode":"(async (sourcePlayer: IPlayer, target: IProperty, gameProcess: IGameProcess) => {\n    if (target.level <= 0) {\n        throw Error(\"è¯¥åœ°äº§æ²¡æœ‰å»ºç­‘å¯ä»¥æ‹†é™¤\");\n    }\n    const owner = target.owner;\n    const propertyName = target.name;\n    const oldLevel = target.level;\n    const compensation = Math.floor(target.buildCost / 2);\n    await target.levelDown();\n    if (owner) {\n        await owner.gain(compensation, MoneyTag.CARD);\n    }\n    await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n        title: \"æ‹†è¿ä»¤\",\n        content: `${sourcePlayer.name} å¯¹ <b>${propertyName}</b> å‘åŠ¨äº†æ‹†è¿ä»¤ï¼<br>å»ºç­‘ç­‰çº§ ${oldLevel} â†’ ${oldLevel - 1}<br>${owner ? `ä¸šä¸» <b>${owner.name}</b> è·å¾—è¡¥å¿ <color:primary>ï¿¥${compensation}</color>` : \"è¯¥åœ°äº§æ— ä¸»ï¼Œæ— è¡¥å¿\"}`,\n        duration: 3000\n    });\n});"},{"id":"card-b35ll0","name":"é¡ºæ‰‹ç‰µç¾Š","type":"ToOtherPlayer","description":"éšæœºå·å–ç›®æ ‡ç©å®¶çš„ä¸€å¼ æœºä¼šå¡æ®ä¸ºå·±æœ‰","color":"#b243d0","iconId":"image-kua4wm","effectCode":"(async ( sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    const targetPlayer = target;\n    if (targetPlayer.chanceCards.length === 0) {\n        throw Error(\"ç›®æ ‡ç©å®¶æ²¡æœ‰æœºä¼šå¡å¯ä»¥å·å–\");\n    }\n    const stolenCard = targetPlayer.chanceCards[Math.floor(Math.random() * targetPlayer.chanceCards.length)];\n    const sourceId = stolenCard.getSourceId();\n    const newCard = gameProcess.createNewChanceCard(sourceId);\n    await targetPlayer.loseCard(stolenCard.getId());\n    await sourcePlayer.gainCard(newCard);\n    await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n        title: \"é¡ºæ‰‹ç‰µç¾Š\",\n        content: `${sourcePlayer.name} ä» <b>${targetPlayer.name}</b> æ‰‹ä¸­å·èµ°äº†ä¸€å¼ æœºä¼šå¡ï¼<br><color:primary>${stolenCard.getName()}</color>`,\n        duration: 3000\n    });\n})"},{"id":"card-bfztcy","name":"ä¹Œé¾Ÿå¡","color":"#96ab5f","description":"è®©ç›®æ ‡ç©å®¶çš„æ‰€æœ‰éª°å­ä¸‹ä¸€æ¬¡ç»“æœä¸º1","type":"ToPlayer","iconId":"image-c5uil7","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n  for(const dice of target.dices){\n    dice.setProphecy(1);\n  }\n});"},{"id":"card-d7p72h","name":"å¤åˆ©æ•ˆåº”","type":"ToSelf","description":"è·å¾—é‡‘é’±å¢åŠ 20%ï¼ŒæŒç»­3å›åˆ","color":"#4caf50","iconId":"image-lzky21","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    if (sourcePlayer.modifierManager.hasBuffWithTag('compound-interest')) {\n        throw Error(`${sourcePlayer.name} çš„å¤åˆ©æ•ˆåº”æ•ˆæœæ­£åœ¨è¿›è¡Œä¸­ï¼Œæ— æ³•å åŠ ï¼`);\n    }\n    const modId = sourcePlayer.modifierManager.add($mod__compound_interest_boost);\n    sourcePlayer.modifierManager.add($mod__compound_interest_cleanup, async () => {\n        sourcePlayer.modifierManager.removeById(modId);\n        gameProcess.msgNotifyBroadcast('info', `${sourcePlayer.name} çš„å¤åˆ©æ•ˆåº”å·²ç»“æŸï¼`);\n    });\n})"},{"id":"card-e360xf","name":"ç´§æ€¥æŠ›å”®","type":"ToSelf","description":"é€‰æ‹©ä¸€å¼ è‚¡ç¥¨ï¼Œå°†è‡ªå·±çš„ä»½é¢å…¨éƒ¨å–å‡º","color":"#d4b440","iconId":"image-tdfah0","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    const holdings = gameProcess.stockMarket.getPlayerHoldingStock(sourcePlayer.id);\n    const active = holdings.filter(h => h.holding > 0); if (active.length === 0) {\n        throw new Error(\"æ²¡æœ‰ä»»ä½•æŒä»“ï¼Œæ— æ³•æ‰§è¡Œç´§æ€¥æŠ›å”®\");\n    }\n    const result = await gameProcess.showItemSelectDialog(sourcePlayer.id, {\n        title: \"ç´§æ€¥æŠ›å”®\",\n        content: \"é€‰æ‹©è¦æ¸…ä»“çš„è‚¡ç¥¨ï¼ˆä»¥å½“å‰å¸‚ä»·å–å‡ºï¼Œæ‰£é™¤1%æ‰‹ç»­è´¹ï¼‰\",\n        itemList: active.map(h => ({\n            id: h.stock.id,\n            display: `${h.stock.name}  æŒä»“:${h.holding}è‚¡  ç°ä»·:ï¿¥${h.stock.price.toFixed(1)}`\n        }))\n    });\n    if (!result.selected.length) return;\n    const stockId = result.selected[0];\n    const amount = gameProcess.stockMarket.getHolding(sourcePlayer.id, stockId);\n    const receipt = gameProcess.stockMarket.commitSell(sourcePlayer.id, stockId, amount);\n    if (!receipt) return;\n    await sourcePlayer.gain(receipt.totalCost, 'stock_sell');\n    gameProcess.msgNotifyBroadcast(\"warning\", `${sourcePlayer.name} ç´§æ€¥æŠ›å”®äº† ${receipt.amount}è‚¡\n  ${receipt.stockName}ï¼Œå›æ”¶ ï¿¥${receipt.totalCost.toFixed(0)}`);\n    await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n        title: \"ç´§æ€¥æŠ›å”®\",\n        content: `<color:primary>${sourcePlayer.name}</color> ç´§æ€¥æ¸…ä»“<br><b>${receipt.stockName}</b>\n  ${receipt.amount}è‚¡ Ã— ï¿¥${receipt.price.toFixed(1)}<br>æ‰‹ç»­è´¹æ‰£é™¤ååˆ°è´¦\n  <color:gold><b>ï¿¥${receipt.totalCost.toFixed(0)}</b></color>`,\n        duration: 3000\n    });\n})"},{"id":"card-ebstji","name":"é­”æ³•éª°å­","color":"#bd14a7","description":"ä½ å¯ä»¥å†³å®šç›®æ ‡ç©å®¶æ‰€æœ‰éª°å­ä¸‹ä¸€æ¬¡æ·å‡ºçš„ç‚¹æ•°","type":"ToPlayer","iconId":"image-gvgzzn","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    for (let i = 0; i < target.dices.length; i++) {\n        const dice = target.dices[i];\n        const res = await gameProcess.showItemSelectDialog(sourcePlayer.id, {\n            title: `çŒé“…éª°å­: é€‰æ‹©ç¬¬ ${i + 1} ä¸ªéª°å­`,\n            content: ``,\n            itemList: dice.diceValues.map(v => ({\n                id: `${v}`,\n                display: `${v}`,\n            }))\n        })\n        dice.setProphecy(Number(res.selected[0]));\n    }\n});"},{"id":"card-efdbcc64-fd07-4cff-b93e-6dc8e03a5a33","name":"éª°å­ç¨","type":"ToPlayer","description":"ç›®æ ‡ç©å®¶ä¸‹æ¬¡æ·éª°éœ€æ”¯ä»˜ç‚¹æ•°x200çš„ç¨","color":"#ff5722","iconId":"image-smf2t5","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    target.diceTaxSource = sourcePlayer.id;\n    target.modifierManager.add($mod__dice_tax);\n})"},{"id":"card-f30c6c03-c51f-4173-a650-1e7c967b5632","name":"ä¸¤æåè½¬","type":"ToSelf","description":"æ‰€æœ‰å…¶ä»–ç©å®¶ä¸‹ä¸€å›åˆå€’ç€èµ°è·¯","color":"#e91e63","iconId":"image-wnq9gi","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    const targets = Array.from(gameProcess.players.values()).filter(p => p.id !== sourcePlayer.id);\n    for (const t of targets) {\n        t.modifierManager.add($mod__reverse_walk);\n    }\n    const playerIds = Array.from(gameProcess.players.keys());\n    await gameProcess.showMessageCard(playerIds, {\n        title: 'åå‘è¡Œèµ°',\n        content: targets.map(function (t) { return '<b>' + t.name + '</b>è¢«æ–½åŠ äº†<color:red><b>åå‘è¡Œèµ°</b></color>ï¼<br>ä¸‹ä¸€å›åˆå°†å€’ç€èµ°è·¯'; }).join('<br>'),\n        duration: 3000\n    });\n})"},{"id":"card-f447e767-551f-4ca8-a082-6351c2b4603d","name":"åŠ«å¯Œæµè´«","type":"ToSelf","description":"ä»é‡‘é’±æœ€å¤šçš„ç©å®¶æ‰‹ä¸­å¤ºå– 10% ç°é‡‘ï¼Œåˆ†ç»™é‡‘é’±æœ€å°‘çš„ç©å®¶","color":"#e86d26","iconId":"image-l9mbc1","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    const allPlayers = Array.from(gameProcess.players.values()).filter(p => !p.isBankrupted);\n    allPlayers.sort((a, b) => a.money - b.money);\n    const poorest = allPlayers[0];\n    const richest = allPlayers[allPlayers.length - 1];\n    if (poorest === richest) return;\n    const stealAmount = Math.floor(richest.money * 0.1);\n    if (stealAmount <= 0) return;\n    const costRes = await richest.cost(stealAmount, MoneyTag.CARD, poorest);\n    await poorest.gain(costRes.actualCost, MoneyTag.CARD, richest);\n    await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n        title: 'åŠ«å¯Œæµè´«',\n        content: `ä»<color:gold><b>${richest.name}</b></color>å¤„å¤ºå–äº†<color:red><b>${costRes.actualCost}</b></color>ï¿¥\\n  <br>èµ äºˆ<color:green><b>${poorest.name}</b></color>`,\n        duration: 3000\n    });\n})"},{"id":"card-fbj2cq","name":"å†…å¹•äº¤æ˜“","type":"ToSelf","description":"çª¥æ¢æ‰€æœ‰è‚¡ç¥¨çš„å†…éƒ¨è¶‹åŠ¿ï¼Œç„¶åé€‰æ‹©ä¸€æ”¯ç§˜å¯†è´­ä¹° 10 è‚¡","color":"#11a5d5","iconId":"image-5w3awq","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    const buyAmount = 10;\n    const peekResult = await gameProcess.peekStockTrend(sourcePlayer.id, {\n        title: \"æœºå¯†æƒ…æŠ¥\",\n        content: \"ä½ é€šè¿‡ç‰¹æ®Šæ¸ é“è·å–äº†è‚¡å¸‚å†…å¹•ï¼Œé€‰æ‹©ä¸€åªè‚¡ç¥¨ç§˜å¯†ä¹°å…¥<b>10è‚¡</b>\",\n        cancelText: \"å–æ¶ˆ\",\n        column: 3\n    });\n    if (!peekResult) {\n        await gameProcess.showMessageCard([sourcePlayer.id], {\n            title: \"å†…å¹•äº¤æ˜“\",\n            content: \"è‚¡å¸‚ä¼‘å¸‚ä¸­ï¼Œæƒ…æŠ¥é€šé“æš‚æ—¶å…³é—­â€¦â€¦\",\n            duration: 3000\n        });\n        return;\n    }\n\n    const sm = gameProcess.stockMarket;\n    const totalCost = sm.getTransactionCost(peekResult.stockId, buyAmount);\n    const check = sm.canTrade(sourcePlayer.id, peekResult.stockId, buyAmount, true);\n    if (!check.ok) {\n        await gameProcess.showMessageCard([sourcePlayer.id], {\n            title: \"äº¤æ˜“å¤±è´¥\",\n            content: check.msg || \"å½“å‰æ— æ³•äº¤æ˜“\",\n            duration: 3000\n        });\n        return;\n    }\n\n    if (sourcePlayer.money < totalCost) {\n        await gameProcess.showMessageCard([sourcePlayer.id], {\n            title: \"èµ„é‡‘ä¸è¶³\",\n            content: \"ä¹°å…¥\" + peekResult.stockName + \"éœ€èŠ±è´¹ <color:red>$\" + totalCost + \"</color>ï¼Œä½ çš„ä½™é¢ä¸è¶³ã€‚\",\n            duration: 3000\n        });\n        return;\n    }\n\n    await sourcePlayer.cost(totalCost, MoneyTag.CARD);\n    const receipt = sm.commitBuy(sourcePlayer.id, peekResult.stockId, buyAmount);\n    if (receipt) {\n        await gameProcess.showMessageCard([sourcePlayer.id], {\n            title: \"äº¤æ˜“å®Œæˆ\",\n            content: \"æˆåŠŸä¹°å…¥ <color:primary>\" + receipt.stockName + \"</color> Ã—\" + receipt.amount +\n                \"<br>æˆäº¤ä»·ï¼š$\" + receipt.price + \"/è‚¡<br>æ€»èŠ±è´¹ï¼š<color:red>$\" + receipt.totalCost + \"</color>\",\n            duration: 3000\n        });\n    }\n\n    gameProcess.msgNotifyBroadcast(\"info\", \"æœ‰ç¥ç§˜èµ„é‡‘æ‚„æ‚„å…¥åœºâ€¦â€¦\");\n})"},{"id":"card-fmcip7","name":"éšæœºä¼ é€","type":"ToOtherPlayer","description":"æ‰€æœ‰ç©å®¶è¢«éšæœºä¼ é€åˆ°åœ°å›¾ä¸Šçš„ä¸åŒä½ç½®","color":"#8B008B","iconId":"image-paifbh","effectCode":"(async ( sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n  const allPlayers = Array.from(gameProcess.players.values()).filter((player) => !player.isBankrupted);\n  const pathMapItemIds = [...gameProcess.getPathMapItemIds()];\n\n  if (allPlayers.length < 2) {\n    throw new Error(\"åœºä¸Šç©å®¶ä¸è¶³\");\n  }\n  if (pathMapItemIds.length < allPlayers.length) {\n    throw new Error(\"åœ°å›¾è·¯å¾„èŠ‚ç‚¹ä¸è¶³ï¼Œæ— æ³•ä¸ºæ‰€æœ‰ç©å®¶åˆ†é…ä¸åŒä½ç½®\");\n  }\n\n  for (let cursor = pathMapItemIds.length - 1; cursor > 0; cursor -= 1) {\n    const swapCursor = Math.floor(Math.random() * (cursor + 1));\n    [pathMapItemIds[cursor], pathMapItemIds[swapCursor]] = [pathMapItemIds[swapCursor], pathMapItemIds[cursor]];\n  }\n\n  const destinationMapItemIds = pathMapItemIds.slice(0, allPlayers.length);\n  const fixedSlots = destinationMapItemIds\n    .map((mapItemId, slot) => mapItemId === allPlayers[slot].positionMapItemId ? slot : -1)\n    .filter((slot) => slot >= 0);\n\n  if (fixedSlots.length === 1) {\n    const fixedSlot = fixedSlots[0];\n    const swapSlot = fixedSlot === 0 ? 1 : 0;\n    [destinationMapItemIds[fixedSlot], destinationMapItemIds[swapSlot]] = [destinationMapItemIds[swapSlot], destinationMapItemIds[fixedSlot]];\n  } else if (fixedSlots.length > 1) {\n    const lastMapItemId = destinationMapItemIds[fixedSlots[fixedSlots.length - 1]];\n    for (let cursor = fixedSlots.length - 1; cursor > 0; cursor -= 1) {\n      destinationMapItemIds[fixedSlots[cursor]] = destinationMapItemIds[fixedSlots[cursor - 1]];\n    }\n    destinationMapItemIds[fixedSlots[0]] = lastMapItemId;\n  }\n\n  const details: string[] = [];\n  for (let slot = 0; slot < allPlayers.length; slot += 1) {\n    const player = allPlayers[slot];\n    const destinationMapItemId = destinationMapItemIds[slot];\n    await player.tpToMapItem(destinationMapItemId);\n    details.push(`${player.name}: ${destinationMapItemId}`);\n  }\n\n  await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n    title: \"éšæœºä¼ é€\",\n    content: `<b>éšæœºä¼ é€</b> å¯åŠ¨ï¼æ‰€æœ‰ç©å®¶è¢«ä¼ é€åˆ°éšæœºä½ç½®ï¼`,\n    duration: 5000\n  });\n});"},{"id":"card-fqxyvw","name":"å½©ç¥¨å¤§æ´¾é€","type":"ToSelf","description":"å…è´¹è·å¾— 3 å¼ å½©ç¥¨ï¼Œä¸èŠ±é’±ç›´æ¥å½•å…¥","color":"#f44336","iconId":"image-vw02qh","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    const lm = gameProcess.lotteryManager;\n    if (lm.stock.length === 0) {\n        throw Error(\"å½©ç¥¨å·²å”®ç½„ï¼Œæ— æ³•é¢†å–\");\n    }\n    const count = Math.min(3, lm.stock.length);\n    const picked: number[] = [];\n    const stockCopy = [...lm.stock];\n    for (let i = 0; i < count; i++) {\n        const idx = Math.floor(Math.random() * stockCopy.length);\n        picked.push(stockCopy[idx]);\n        stockCopy.splice(idx, 1);\n    }\n    await lm.buyLottery(sourcePlayer, picked);\n    await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n        title: \"å½©ç¥¨å¤§æ´¾é€\",\n        content: `${sourcePlayer.name} å…è´¹è·å¾—äº† <b>${count}</b> å¼ å½©ç¥¨ï¼<br><color:primary>${picked.join(\"ã€\")}</color>`,\n        duration: 3000\n    });\n})"},{"id":"card-ghue5b","name":"æ¶¨åœæ¿","type":"ToSelf","description":"æŒ‡å®šä¸€æ”¯è‚¡ç¥¨ç¬é—´æš´æ¶¨è‡³æ¶¨åœä»·ï¼Œå¤¯çˆ†äº†","color":"#ba182a","iconId":"image-ryox2u","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n  const stockMarket = gameProcess.stockMarket;\n\n  // æ„å»ºè‚¡ç¥¨é€‰æ‹©åˆ—è¡¨\n  const items = stockMarket.data.stocks.map((stock) => ({\n    id: stock.id,\n    display: {\n      id: \"stock-\" + stock.id,\n      type: \"div\" as const,\n      style: { background: '#ffffff', borderRadius: '1rem' },\n      variable: {\n        stockName: stock.name,\n        stockColor: stock.color,\n        areaColor: stock.display.color,\n        areaPath: stock.display.areaPath,\n        linePath: stock.display.linePath,\n        price: stock.display.price,\n        percent: stock.display.percent,\n      },\n      children: [\n        $ui__stock_preview\n      ]\n    }\n  }));\n\n  // å¼¹å‡ºé€‰æ‹©å¯¹è¯æ¡†\n  const result = await gameProcess.showItemSelectDialog(sourcePlayer.id, {\n    title: \"é€‰æ‹©æ¶¨åœç›®æ ‡\",\n    content: \"é€‰æ‹©ä¸€æ”¯è‚¡ç¥¨ä½¿å…¶æ¶¨åœï¼\",\n    itemList: items\n  });\n\n  if (!result.selected.length) return;\n\n  const stockId = result.selected[0];\n  const stock = stockMarket.getStock(stockId);\n  if (!stock) return;\n\n  // æ¶¨åœæ•ˆæœï¼šæ‹‰æ»¡çƒ­åº¦ + å¼ºè¶‹åŠ¿ + BUILDäº‹ä»¶å†²å‡»\n  stock.heat = 5;\n  stock.trend = 0.95;\n  stockMarket.triggerEvent(stockId, \"BUILD\", 3);\n\n  // å…¨å±€å¹¿æ’­\n  gameProcess.msgNotifyBroadcast(\"success\", `${sourcePlayer.name} å¼•çˆ†äº† ${stock.name}ï¼Œç›´æ¥æ¶¨åœï¼`);\n  await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n    title: \"æ¶¨åœæ¿\",\n    content: `<b><color:red>${stock.name}</color></b> è¢«æ‹‰å‡è‡³æ¶¨åœï¼<br>å½“å‰ä»·æ ¼ï¼š<b>Â¥${stock.price.toFixed(1)\n      }</b><br><color:primary>å¸‚åœºçƒ­åº¦é£™å‡ï¼Œåç»­æ³¢åŠ¨å°†åŠ å‰§</color>`,\n    duration: 3000\n  });\n})"},{"id":"card-jn5s7n","name":"å‘½è¿éª°å’’","color":"#9c27b0","description":"è®°å½•ç›®æ ‡ç©å®¶æ¥ä¸‹æ¥3æ¬¡æ·éª°çš„æ€»ç‚¹æ•°ï¼Œ3æ¬¡åæŒ‰æ€»ç‚¹æ•°*10æ‰£é™¤é‡‘é’±","type":"ToOtherPlayer","iconId":"image-s6gxv7","effectCode":"(async ( sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n  const targetPlayer = target;\n  targetPlayer.diceCurse = { rolls: [], resolved: false };\n  gameProcess.msgNotifyBroadcast('info', `${sourcePlayer.name} å¯¹ ${targetPlayer.name} æ–½æ”¾äº†å‘½è¿éª°å’’ï¼è®°å½•æ¥ä¸‹æ¥ 3 æ¬¡æ·éª°...`);\n  targetPlayer.modifierManager.add($mod__dice_curse);\n})"},{"id":"card-kfyl5m","name":"æ—¶é—´å€’æµ","type":"ToSelf","description":"å›åˆç»“æŸæ—¶è¿”å›åˆ°å½“å‰ä½ç½®ï¼ˆè§¦å‘åˆ°è¾¾æ•ˆæœï¼‰","color":"#5a79d8","iconId":"image-yl0121","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n  const sourcePlayerState = sourcePlayer as IPlayer & { timeReversalMapItemId?: string };\n  const currentMapItemId = sourcePlayer.positionMapItemId;\n  if (!currentMapItemId || !gameProcess.mapData.mapItems.some((mapItem) => mapItem.id === currentMapItemId)) {\n    throw new Error(\"æ— æ³•ä¿å­˜å½“å‰ MapPath åœ°å›¾é¡¹ä½ç½®\");\n  }\n  sourcePlayerState.timeReversalMapItemId = currentMapItemId;\n  gameProcess.msgNotifyBroadcast('info', `${sourcePlayer.name} å‘åŠ¨äº†æ—¶é—´å€’æµï¼`);\n  sourcePlayer.modifierManager.add($mod__time_reversal);\n})"},{"id":"card-mwzb3g","name":"æŠ¢åœ°","color":"#7a5549","description":"é€‰æ‹©ä¸€åç©å®¶è¿›è¡Œéª°å­å†³æ–—ï¼Œå½“ä½ è·èƒœåå¯ä»¥éšæœºè·å¾—å¯¹æ–¹çš„ä¸€å—åœ°çš®","type":"ToOtherPlayer","iconId":"image-jtebwk","effectCode":"(async ( sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n  function colorfulName(p: IPlayer) {\n    return `<color:${p.getUser().color}>${p.name}</color>`;\n  }\n\n  const targetPlayer = target;\n  if (targetPlayer.properties.length === 0) {\n    throw Error(\"ç›®æ ‡æ²¡æœ‰åœ°çš®ï¼Œæ”¾è¿‡TAå§\");\n  }\n\n  const srcRoll = await sourcePlayer.rollDices();\n  const tgtRoll = await targetPlayer.rollDices();\n  const srcTotal = srcRoll.reduce((sum: number, r: DiceResult) => sum + r.result, 0);\n  const tgtTotal = tgtRoll.reduce((sum: number, r: DiceResult) => sum + r.result, 0);\n\n  const srcWon = srcTotal > tgtTotal;\n  const winner = srcWon ? sourcePlayer : targetPlayer;\n  const stolenProp = targetPlayer.properties[Math.floor(Math.random() * targetPlayer.properties.length)];\n\n  const content =\n    `${colorfulName(sourcePlayer)} æ·å‡ºäº†ï¼š<color:second>${srcRoll.map((r: DiceResult) => r.result).join(' + ')}</color> ä¸€å…±<color:primary>${srcTotal}</color> ç‚¹<br>`\n    + `${colorfulName(targetPlayer)} æ·å‡ºäº†ï¼š<color:second>${tgtRoll.map((r: DiceResult) => r.result).join(' + ')}</color> ä¸€å…±<color:primary>${tgtTotal}</color> ç‚¹<br>`\n    + `${colorfulName(winner)} è·èƒœï¼Œ`\n    + (srcWon\n      ? `${colorfulName(sourcePlayer)} è·å¾— ${colorfulName(targetPlayer)} çš„åœ°çš®ï¼š${stolenProp.name}`\n      : `${colorfulName(targetPlayer)} è·å¾—æŒ‘æˆ˜è€… ${sourcePlayer.name} çš„ ï¿¥2000 èµ”å¿`);\n\n  await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n    title: \"æŠ¢åœ°ï¼šéª°å­å†³æ–—ç»“æœ\",\n    content,\n    duration: 5000\n  });\n\n  if (srcWon) {\n    await stolenProp.setOwner(sourcePlayer);\n  } else {\n    if (sourcePlayer.money >= 2000) {\n      const costRes = await sourcePlayer.cost(2000, MoneyTag.PLAYER, targetPlayer);\n      await targetPlayer.gain(costRes.actualCost, MoneyTag.PLAYER, sourcePlayer);\n    } else {\n      const costRes = await sourcePlayer.cost(sourcePlayer.money, MoneyTag.PLAYER, targetPlayer);\n      await targetPlayer.gain(costRes.actualCost, MoneyTag.PLAYER, sourcePlayer);\n    }\n  }\n})"},{"id":"card-pmhu37","name":"è‚¡æ¯åˆ†çº¢","type":"ToSelf","description":"æ ¹æ®ä½ çš„æ€»æŒä»“è‚¡æ•°ï¼Œæ¯è‚¡å‘æ”¾ ï¿¥50 ç°é‡‘åˆ†çº¢ï¼ŒæŒä»“è¶Šå¤šæ”¶ç›Šè¶Šå¤§","color":"#e3b33b","iconId":"image-zce1w9","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n  const sm = gameProcess.stockMarket;\n  if (!sm.data.isOpen) {\n    throw new Error(\"è‚¡å¸‚ä¼‘å¸‚ä¸­ï¼Œæ— æ³•é¢†å–è‚¡æ¯åˆ†çº¢\");\n  }\n  const holdings = sm.getPlayerHoldingStock(sourcePlayer.id);\n  const active = holdings.filter(h => h.holding > 0);\n  if (active.length === 0) {\n    throw new Error(\"æ²¡æœ‰ä»»ä½•æŒä»“ï¼Œæ— æ³•é¢†å–è‚¡æ¯åˆ†çº¢\");\n  }\n  const totalShares = active.reduce((sum, h) => sum + h.holding, 0);\n  const dividend = totalShares * 50;\n  await sourcePlayer.gain(dividend, MoneyTag.CARD);\n  const details = active.map(h => h.stock.name + \" \" + h.holding + \"è‚¡\").join(\"ã€\");\n  await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n    title: \"è‚¡æ¯åˆ†çº¢\",\n    content: \"<color:primary>\" + sourcePlayer.name + \"</color> é¢†å–äº†è‚¡æ¯åˆ†çº¢<br>æŒä»“ï¼š\" + details + \"<br>å…± <b>\" + totalShares + \"</b> è‚¡ Ã— ï¿¥50 = <color:primary><b>ï¿¥\" + dividend + \"</b></color>\",\n    duration: 3000\n  });\n})"},{"id":"card-s19prt","name":"æ³¡æ²«ç»æµ","color":"#ff9800","description":"ä½ çš„å½“å‰åœ°äº§è¿‡è·¯è´¹ç¿»å€ï¼ŒæŒç»­3å›åˆã€‚ä½†åˆ°æœŸåè¿‡è·¯è´¹ç¿»å€çš„å»ºç­‘é™1çº§","type":"ToPlayer","iconId":"image-mjecmu","effectCode":"(async ( sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n  // é˜²æ­¢å åŠ æ•ˆæœ\n  if (sourcePlayer.modifierManager.hasBuffWithTag('foam-economy')) {\n    throw new Error(`${sourcePlayer.name} çš„æ³¡æ²«ç»æµæ•ˆæœæ­£åœ¨è¿›è¡Œä¸­ï¼Œæ— æ³•å åŠ ï¼`);\n  }\n\n  // åˆå§‹åŒ–å›åˆè®¡æ•°å™¨\n  sourcePlayer.foamEconomyRound = 0;\n\n  // æ·»åŠ ç©å®¶ä¿®é¥°å™¨ï¼šå›åˆè®¡æ•°+é™çº§\n  sourcePlayer.modifierManager.add($mod__foam_economy);\n\n  // ç»™ç©å®¶æ‰€æœ‰åœ°äº§æ·»åŠ ç¿»å€ä¿®é¥°å™¨\n  for (const prop of sourcePlayer.properties) {\n    prop.modifierManager.add($mod__foam_economy_double);\n  }\n})"},{"id":"card-vjm864","name":"ç»æµå¯’å†¬","type":"ToPlayer","description":"ç›®æ ‡ç©å®¶3å›åˆå†…è·å¾—çš„é’±æ•°å‡å°‘20%","color":"#d93f3f","iconId":"image-dv5377","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    const modId = target.modifierManager.add($mod__economic_winter_debuff);\n    target.modifierManager.add($mod__economic_winter_cleanup, async () => {\n        target.modifierManager.removeById(modId);\n        gameProcess.msgNotifyBroadcast('info', `${target.name} çš„ç»æµå¯’å†¬å·²ç»“æŸï¼`);\n    });\n    gameProcess.msgNotifyBroadcast(`warning`, `${sourcePlayer.name} å¯¹ ${target.name} æ–½åŠ äº†ç»æµå¯’å†¬ï¼æ”¶å…¥å‡å°‘20%ï¼ŒæŒç»­3å›åˆã€‚`);\n})"},{"id":"card-y472rl","name":"éª°å­è€è™æœº","color":"#d19c29","description":"æ·ä¸€æ¬¡éª°å­ï¼Œè·å¾— æ€»ç‚¹æ•° * 200 å—é’±ï¼Œå¦‚æœç‚¹æ•°ç›¸åŒåˆ™ç¿»å€","type":"ToSelf","iconId":"image-avnok7","effectCode":"(async ( sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    const rollRes = await sourcePlayer.rollDices();\n    let rollCount = rollRes.map(r => r.result).reduce((p, c) => p + c);\n    if (rollRes.every(v => v.result === rollRes[0].result)) {\n        rollCount *= 2;\n    }\n    await sourcePlayer.gain(rollCount * 200, MoneyTag.CARD);\n});"},{"id":"card-zmo535","name":"è·Œåœæ¿","type":"ToSelf","description":"æŒ‡å®šä¸€æ”¯è‚¡ç¥¨ç¬é—´æš´è·Œè‡³è·Œåœä»·ï¼Œæ‹‰å®Œäº†","color":"#24a11b","iconId":"image-iegie9","effectCode":"(async (sourcePlayer: IPlayer, target: IPlayer, gameProcess: IGameProcess) => {\n    const stockMarket = gameProcess.stockMarket;\n    const items = stockMarket.data.stocks.map((s: any) => ({\n        id: s.id,\n        display: {\n            id: \"stock-\" + s.id,\n            type: \"div\" as const,\n            style: { background: '#ffffff', borderRadius: '1rem' },\n            variable: {\n                stockName: s.name,\n                stockColor: s.color,\n                areaColor: s.display.color,\n                areaPath: s.display.areaPath,\n                linePath: s.display.linePath,\n                price: s.display.price,\n                percent: s.display.percent,\n            },\n            children: [\n                $ui__stock_preview\n            ]\n        }\n    }));\n\n    const result = await gameProcess.showItemSelectDialog(sourcePlayer.id, {\n        title: \"é€‰æ‹©ç ¸ç›˜ç›®æ ‡\",\n        content: \"é€‰æ‹©ä¸€æ”¯è‚¡ç¥¨ä½¿å…¶è·Œåœï¼\",\n        itemList: items\n    });\n\n    if (!result.selected.length) return;\n\n    const stockId = result.selected[0];\n    const stock = stockMarket.getStock(stockId);\n    if (!stock) return;\n\n    const oldPrice = stock.price;\n    stock.heat = 0;\n    stock.trend = -0.95;\n    stock.price = Math.max(5, oldPrice * 0.9);\n    stock.changeRate = (stock.price - oldPrice) / oldPrice;\n    stock.history.push(stock.price);\n    if (stock.history.length > 20) stock.history.shift();\n\n    gameProcess.msgNotifyBroadcast(\"error\", sourcePlayer.name + \" ç ¸ç›˜äº† \" + stock.name + \"ï¼Œç›´æ¥è·Œåœï¼\");\n    await gameProcess.showMessageCard(gameProcess.getAllPlayersId(), {\n        title: \"è·Œåœæ¿\",\n        content: \"<b><color:green>\" + stock.name + \"</color></b> è¢«ç ¸è‡³è·Œåœï¼<br>å½“å‰ä»·æ ¼ï¼š<b>Â¥\" +\n            stock.price.toFixed(1) + \"</b><br><color:red>å¸‚åœºä¸€ç‰‡å“€åšï¼Œææ…Œæƒ…ç»ªè”“å»¶</color>\",\n        duration: 3000\n    });\n})"}],"mapItemTypes":[{"id":"map-item-type-41gi4c","name":"å…¬äº¤ç«™","modelId":"model-bbec2d5e-01aa-4fe5-9e30-261849d96f9d","color":"#c64239","size":1},{"id":"map-item-type-8ty8pf","name":"è¯åˆ¸ä¸­å¿ƒ","modelId":"model-44d53d3d-b3a5-4196-98b7-1563111460e1","color":"#90886f","size":1},{"id":"map-item-type-90ca6p","name":"æºœç¼åœ°å—","modelId":"model-0f838b1d-ddfe-48c6-a6bc-37e860fe3452","color":"#676f98","size":1},{"id":"map-item-type-cjscr2","name":"è·¯1","modelId":"model-59a48297-1b26-488e-a211-1d73d5a7ba25","color":"#9f6068","size":1},{"id":"map-item-type-dh0oy5","name":"å»ç›‘ç‹±è£…é¥°","modelId":"model-3fyfqc","color":"#629d7a","size":1},{"id":"map-item-type-eon1jp","name":"æ¡Œå­","modelId":"model-ae76c5ff-7850-4281-8bd5-08ffdd884387","color":"#b826d9","size":1},{"id":"map-item-type-grooot","name":"ç›‘ç‹±","modelId":"model-9a732baf-6c9c-440c-a6d8-a66d526c1540","color":"#798486","size":1},{"id":"map-item-type-hn3zik","name":"è£…é¥°åœ°å—-2","modelId":"model-g9shr4","color":"#53ac83","size":1},{"id":"map-item-type-i17qnr","name":"èµ·ç‚¹è£…é¥°","modelId":"model-f0u7du","color":"#27d8c2","size":1},{"id":"map-item-type-sctqpy","name":"åœ°äº§åœ°å—","modelId":"model-b184ce78-5f1b-4f7f-b0e3-bb5f3ea07e55","color":"#75728d","size":1},{"id":"map-item-type-ulzf20","name":"å½©ç¥¨","modelId":"model-y8kep0","color":"#eb1424","size":1},{"id":"map-item-type-uzegiz","name":"è·¯2","modelId":"model-7f8184ff-841e-4814-9abd-a4b46f0d7ea7","color":"#dce31c","size":1},{"id":"map-item-type-w2cvh4","name":"å•†åº—","modelId":"model-038e3473-ae5f-4dda-b7f1-9920db0124ed","color":"#3ac5aa","size":1},{"id":"map-item-type-zjojeh","