diff --git a/apps/client/src/utils/static-mode.ts b/apps/client/src/utils/static-mode.ts
new file mode 100644
index 0000000..69d1968
--- /dev/null
+++ b/apps/client/src/utils/static-mode.ts
@@ -0,0 +1,37 @@
+/**
+ * 静态部署模式（VITE_STATIC_MODE=1）：没有后端、没有登录，只保留本地派对。
+ * 联机房间、账号、服务端地图列表都不可用，地图只能从本地文件导入。
+ */
+export const IS_STATIC = import.meta.env.VITE_STATIC_MODE === "1";
+
+const GUEST_COLORS = ["#e4572e", "#2a9d8f", "#3a86ff", "#f4a261", "#8e5cf7", "#e76f9a"];
+
+/** 没有身份时直接生成一个本机游客，省掉登录页。 */
+export function ensureGuestUser(): void {
+	if (localStorage.getItem("user") || localStorage.getItem("token")) return;
+	const bytes = crypto.getRandomValues(new Uint8Array(4));
+	const id = Array.from(bytes, (b) => b.toString(16).padStart(2, "0")).join("");
+	localStorage.setItem(
+		"user",
+		JSON.stringify({
+			userId: `temp-player-${id}`,
+			useraccount: "",
+			username: "玩家1",
+			color: GUEST_COLORS[bytes[0] % GUEST_COLORS.length],
+			avatar: "",
+		}),
+	);
+}
+
+/** 大厅左上角的"回街机厅"小链接，只在大厅显示，进了房间和游戏就隐藏，免得挡住界面。 */
+export function setupBackLink(): (routeName: unknown) => void {
+	const link = document.createElement("a");
+	link.href = "../";
+	link.textContent = "← 街机厅";
+	link.style.cssText =
+		"position:fixed;left:10px;top:8px;z-index:50;padding:6px 12px;border-radius:14px;background:rgba(0,0,0,.35);color:#fff;font:600 13px/1 system-ui,sans-serif;text-decoration:none;display:none";
+	document.body.appendChild(link);
+	return (routeName) => {
+		link.style.display = routeName === "room-router" ? "block" : "none";
+	};
+}
